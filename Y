local function laser()
	local R = N.R
	local rp = rayParams(R)
	local DUR = 1.6
	N.Anim = {t = os.clock() + DUR, la = 1.0, ra = 1.0}
	N.Shake(DUR, 0.7)
	local outer = newPart(nil, NEON, NM, 0.25, V3(1, 1, 1))
	local core = newPart(nil, PALE, NM, 0, V3(1, 1, 1))
	local t0 = os.clock()
	local last = 0
	local c
	c = RS.Heartbeat:Connect(function()
		local el = os.clock() - t0
		if el > DUR or not (N.R == R and R.Model.Parent) then
			c:Disconnect()
			outer:Destroy()
			core:Destroy()
			return
		end
		local o = R.Eye.Position
		local d = camAim(rp) - o
		if d.Magnitude < 1 then return end
		d = d.Unit
		local hit = workspace:Raycast(o, d * 700, rp)
		local e = hit and hit.Position or (o + d * 700)
		local len = (e - o).Magnitude
		local grow = math.min(el / 0.15, 1) * (1 - math.max(el - 1.3, 0) / 0.3)
		local wd = math.max((3 + math.sin(el * 60) * 0.6) * grow, 0.05)
		outer.Size = V3(wd * 2, wd * 2, len)
		outer.CFrame = CFrame.lookAt(o, e) * CF(0, 0, -len / 2)
		core.Size = V3(wd * 0.8, wd * 0.8, len)
		core.CFrame = outer.CFrame
		if hit and el - last > 0.12 then
			last = el
			flash(e, 22, 0.3)
			N.Dust(e, 6)
			explode(e, 10)
		end
	end)
end

local FN = {missiles, stomp, dash, sword, plasma, laser}

-- ตัวเรียกสกิลกลาง (ใช้ได้ทั้งโหมดหุ่นและเจ็ท)
function N.Skill(i)
	local S = N.S
	if not S.Riding or S.Busy or not N.R then return end
	local list = S.Jet and N.JetCDT or CDT
	local ct = list and list[i]
	if not ct then return end
	local key = (S.Jet and "J" or "R") .. i
	if cd[key] and os.clock() < cd[key] then return end
	cd[key] = os.clock() + ct
	N.Cool(KEYS[i], ct)
	if S.Jet then
		if N.JetSkill then task.spawn(N.JetSkill, i) end
	elseif i == 3 then
		dash()
	else
		task.spawn(FN[i])
	end
end
