-- สลับการมองเห็นระหว่างร่างหุ่น / ร่างเจ็ท
function N.SetForm(R, jet)
	R.Form = jet and "jet" or "robot"
	for _, p in ipairs(R.RobotParts) do
		if not p:GetAttribute("Keep") then p.Transparency = jet and 1 or 0 end
	end
	for _, p in ipairs(R.JetParts) do
		p.Transparency = jet and 0 or 1
	end
	for _, l in ipairs(R.RobotLights) do l.Enabled = not jet end
	for _, l in ipairs(R.JetLights) do l.Enabled = jet end
end

function N.WingPose(R, t)
	for _, wd in ipairs(R.Wings) do
		if wd.w.Parent then wd.w.C0 = wingC0(wd.s, wd.i, wd.len, t) end
	end
	R.WingT = t
end

function N.WingsTo(R, to, dur)
	local from = R.WingT or 1
	R.WingTok = (R.WingTok or 0) + 1
	local tok = R.WingTok
	task.spawn(function()
		local t0 = os.clock()
		while tok == R.WingTok and R.Model.Parent do
			local a = math.min((os.clock() - t0) / dur, 1)
			local e = a * a * (3 - 2 * a)
			N.WingPose(R, from + (to - from) * e)
			if a >= 1 then break end
			RS.Heartbeat:Wait()
		end
	end)
end

function N.Pose(R, la, ra, ll, rl)
	local J = R.J
	J.LArm.w.C0 = J.LArm.c0 * CFrame.Angles(la, 0, 0)
	J.RArm.w.C0 = J.RArm.c0 * CFrame.Angles(ra, 0, 0)
	J.LLeg.w.C0 = J.LLeg.c0 * CFrame.Angles(ll, 0, 0)
	J.RLeg.w.C0 = J.RLeg.c0 * CFrame.Angles(rl, 0, 0)
end

local function setFlames(list, on)
	for _, p in ipairs(list) do
		local e = p:FindFirstChild("Flame")
		if on and not e then
			local jetF = p:GetAttribute("JetFlame")
			e = Instance.new("ParticleEmitter")
			e.Name = "Flame"
			e.Color = ColorSequence.new(Color3.fromRGB(255, 90, 60), Color3.fromRGB(150, 10, 25))
			e.LightEmission = 1
			e.Rate = jetF and 120 or 80
			e.Lifetime = NumberRange.new(0.4, 0.8)
			e.Speed = jetF and NumberRange.new(60, 100) or NumberRange.new(25, 40)
			e.SpreadAngle = Vector2.new(5, 5)
			e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, jetF and 5 or 3.4), NumberSequenceKeypoint.new(1, 0)})
			e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
			e.EmissionDirection = jetF and Enum.NormalId.Back or Enum.NormalId.Bottom
			e.Parent = p
		end
		if e then e.Enabled = on end
	end
end

function N.Thrust(R, on)
	local jet = R.Form == "jet"
	setFlames(jet and R.Thr or R.JetThr, false)
	setFlames(jet and R.JetThr or R.Thr, on)
end
