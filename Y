local function make(key, text, size, ts, anchor, pos, off)
	local b = Instance.new("TextButton")
	b.Size = size
	b.AnchorPoint = anchor
	b.Position = pos
	b.BackgroundColor3 = BG
	b.BackgroundTransparency = 0.05
	b.AutoButtonColor = false
	b.Text = text
	b.TextColor3 = WHITE
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = ts
	b.TextScaled = false
	b.TextWrapped = true
	b.TextStrokeColor3 = Color3.new(0, 0, 0)
	b.TextStrokeTransparency = 0.3
	b.Visible = false
	b:SetAttribute("Base", text)
	b.Parent = gui
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
	local st = Instance.new("UIStroke", b)
	st.Color = NEON
	st.Thickness = 2
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	N.Pos[key], N.Off[key], N.Stroke[key] = pos, off, st
	b.MouseEnter:Connect(function()
		TS:Create(st, TweenInfo.new(0.15), {Thickness = 4}):Play()
	end)
	b.MouseLeave:Connect(function()
		TS:Create(st, TweenInfo.new(0.15), {Thickness = 2}):Play()
	end)
	N.Btn[key] = b
end

