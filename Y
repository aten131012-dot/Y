local function missiles()
	local R = N.R
	local rp = N.RayParams(R)
	local aim = N.CamAim(rp)
	N.Shake(0.8, 0.8)
	for _ = 1, 4 do
		if not alive(R) then return end
		for gi, gun in ipairs(R.JetGuns) do
			local o = gun.Position + V3(0, -2, 0)
			local cf = R.Root.CFrame
			local sd = (gi == 1) and 1 or -1
			local rnd = V3(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 0.3
			local d = (cf.LookVector * 0.8 + cf.RightVector * sd * 0.6 + V3(0, -0.1, 0) + rnd).Unit
			N.Missile(o, d, aim, rp, 420)
		end
		task.wait(0.18)
	end
end

