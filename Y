local function rayParams(R)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {R.Model, lp.Character}
	return rp
end

local function camAim(rp)
	local cam = workspace.CurrentCamera
	local cp, lv = cam.CFrame.Position, cam.CFrame.LookVector
	local hit = workspace:Raycast(cp, lv * 1000, rp)
	return hit and hit.Position or (cp + lv * 1000)
end

local function newPart(shape, color, mat, tr, size)
	local p = Instance.new("Part")
	if shape then p.Shape = shape end
	p.Material = mat
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = tr
	p.Size = size
	p.Parent = workspace
	return p
end

