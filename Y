-- NEXORA GIANT ROBOT v3 | ไฟล์ 2/6 : สร้างหุ่น (ดาบแดง ปืนแขนซ้าย ปีกใหญ่) + ร่างเครื่องบินเจ็ท
local RS = game:GetService("RunService")
repeat task.wait() until _G.NXG and _G.NXG.Ready
local N = _G.NXG
local CF, V3 = CFrame.new, Vector3.new
local SC = 2.4 -- ขนาดหุ่น (ยิ่งมากยิ่งใหญ่)
N.SCALE = SC

local BLACK = Color3.fromRGB(14, 14, 18)
local GUN = Color3.fromRGB(40, 42, 52)
local SILVER = Color3.fromRGB(130, 134, 148)
local NEON = Color3.fromRGB(255, 25, 45)
local GLASS = Color3.fromRGB(40, 12, 16)
local NM = Enum.Material.Neon
local LENS = {8, 10, 12, 12, 10, 8} -- ความยาวปีกแต่ละใบ (ใหญ่ขึ้น)
local FLOOR = 9.6

local function wingC0(s, i, len, t)
	local function lerp(a, b) return a + (b - a) * t end
	local roll = lerp(62 + (i - 1) * 3, 40 - (i - 1) * 14)
	local yaw = lerp(14, 8 + (i - 1) * 7)
	return CF(s * 1.8 * SC, 5.4 * SC, 2.6 * SC)
		* CFrame.Angles(0, -math.rad(yaw) * s, math.rad(roll) * s)
		* CF(s * len * 0.25 * SC, 0, 0)
end

function N.Build()
	local M = Instance.new("Model")
	M.Name = "NEXORA_Giant"
	local RP, JP, RL, JL = {}, {}, {}, {}
	local grp = "R" -- กลุ่มชิ้นส่วนที่กำลังสร้าง: R = ร่างหุ่น, J = ร่างเจ็ท

	local function mk(name, size, color, mat, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * SC
		p.Color = color
		p.Material = mat or Enum.Material.Metal
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.Anchored = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then p.Shape = shape end
		p.Parent = M
		if grp == "R" then RP[#RP + 1] = p else JP[#JP + 1] = p end
		return p
	end
	local root = mk("Root", V3(4, 1.6, 3), BLACK)
	root.Massless = false
	M.PrimaryPart = root
	local function weld(a, b, c0)
		local w = Instance.new("Weld")
		w.Part0 = a
		w.Part1 = b
		w.C0 = c0
		w.Parent = b
		return w
	end
	local function put(base, name, size, pos, color, mat, rot, shape)
		local p = mk(name, size, color, mat, shape)
		weld(base, p, CF(pos * SC) * (rot or CF()))
		return p
	end
	local function light(part, range, bright)
		local l = Instance.new("PointLight")
		l.Color = NEON
		l.Range = range
		l.Brightness = bright
		l.Parent = part
		if grp == "R" then RL[#RL + 1] = l else JL[#JL + 1] = l end
	end

	local R = {Model = M, Root = root, J = {}, Wings = {}, Pods = {}, Thr = {}, JetThr = {}, JetGuns = {},
		RobotParts = RP, JetParts = JP, RobotLights = RL, JetLights = JL, Form = "robot",
		Floor = FLOOR * SC}
	local cyl = Enum.PartType.Cylinder
	local face90 = CFrame.Angles(0, math.rad(90), 0)

	----------------------------------------------------------------
	-- ร่างหุ่น: ลำตัว
	----------------------------------------------------------------
	put(root, "Waist", V3(4.4, 0.7, 3.2), V3(0, 0.5, 0), SILVER)
	put(root, "Abs", V3(3.4, 1.8, 2.6), V3(0, 1.5, 0), GUN)
	for _, y in ipairs({1.0, 1.5, 2.0}) do
		put(root, "AbsLine", V3(2.8, 0.1, 0.08), V3(0, y, -1.33), NEON, NM)
	end
	put(root, "Chest", V3(6.6, 4.4, 4.0), V3(0, 4.3, 0), BLACK)
	put(root, "ChestTop", V3(5.8, 0.8, 3.6), V3(0, 6.6, 0.1), SILVER)
	put(root, "Window", V3(2.0, 1.3, 0.3), V3(0, 5.1, -2.05), GLASS, Enum.Material.Glass)
	put(root, "WindowEdge", V3(2.2, 0.1, 0.35), V3(0, 5.8, -2.05), NEON, NM)
	put(root, "CoreRing", V3(0.25, 1.7, 1.7), V3(0, 3.2, -2.05), SILVER, nil, face90, cyl)
	local core = put(root, "Core", V3(0.35, 1.2, 1.2), V3(0, 3.2, -2.1), NEON, NM, face90, cyl)
	light(core, 40, 4)
	put(root, "Pack", V3(4.6, 3.8, 1.8), V3(0, 4.6, 2.8), GUN)
	put(root, "PackN", V3(3.8, 0.15, 0.1), V3(0, 5.2, 3.72), NEON, NM)

	for _, s in ipairs({1, -1}) do
		-- แผ่นเกราะอก
		put(root, "ChestPlate", V3(2.2, 3.4, 0.4), V3(s * 2.3, 4.4, -2.1), GUN, nil, CFrame.Angles(0, s * 0.22, 0))
		put(root, "PlateN1", V3(0.12, 3.2, 0.1), V3(s * 1.2, 4.4, -2.3), NEON, NM)
		put(root, "PlateN2", V3(0.14, 3.2, 0.1), V3(s * 3.4, 4.4, -2.0), NEON, NM)
		put(root, "VLine", V3(0.3, 2.0, 0.2), V3(s * 1.0, 2.2, -1.4), NEON, NM, CFrame.Angles(0, 0, -s * 0.45))
		-- ไหล่ใหญ่ + หนาม
		put(root, "Shoulder", V3(3.6, 1.8, 3.8), V3(s * 4.5, 5.8, 0), BLACK)
		put(root, "ShCap", V3(3.8, 0.45, 4.0), V3(s * 4.5, 6.8, 0), SILVER)
		put(root, "ShNeon", V3(3.65, 0.15, 3.85), V3(s * 4.5, 4.95, 0), NEON, NM)
		put(root, "Spike", V3(0.5, 2.8, 0.9), V3(s * 5.4, 7.8, 0), NEON, NM, CFrame.Angles(0, 0, -s * 0.4))
		put(root, "Spike2", V3(0.4, 2.0, 0.7), V3(s * 4.2, 7.6, 1.0), SILVER, nil, CFrame.Angles(0.3, 0, -s * 0.15))
		R.Pods[#R.Pods + 1] = put(root, "Pod", V3(1.8, 1.2, 3), V3(s * 3.2, 7.9, 0.8), GUN)
		put(root, "PodN", V3(1.4, 0.15, 0.1), V3(s * 3.2, 7.9, -0.72), NEON, NM)
		-- ฐานติดปีก
		put(root, "WingMount", V3(1.6, 1.8, 1.4), V3(s * 1.8, 5.4, 2.6), GUN)
		put(root, "WingMountN", V3(0.2, 1.6, 0.2), V3(s * 2.6, 5.4, 2.0), NEON, NM)
	end

	----------------------------------------------------------------
	-- หัว: หมวกเหล็ก ตาดุ ปากเหล็ก เขายาวพุ่งไปด้านหลัง
	----------------------------------------------------------------
	put(root, "Neck", V3(1.4, 1.0, 1.4), V3(0, 7.2, 0), GUN)
	put(root, "Head", V3(2.4, 2.0, 2.4), V3(0, 8.2, 0), BLACK)
	put(root, "Helmet", V3(2.7, 0.6, 2.7), V3(0, 9.3, 0), GUN)
	put(root, "VisorRidge", V3(2.9, 0.3, 0.8), V3(0, 9.0, -1.2), SILVER)
	put(root, "FacePlate", V3(2.0, 1.4, 0.25), V3(0, 8.0, -1.28), GUN)
	put(root, "NoseRidge", V3(0.25, 0.9, 0.3), V3(0, 8.0, -1.5), SILVER)
	put(root, "MouthGuard", V3(1.3, 0.55, 0.3), V3(0, 7.45, -1.38), SILVER)
	for i = -2, 2 do
		put(root, "Teeth", V3(0.07, 0.4, 0.06), V3(i * 0.24, 7.45, -1.56), NEON, NM)
	end
	put(root, "Gem", V3(0.3, 0.3, 0.12), V3(0, 9.0, -1.62), NEON, NM, CFrame.Angles(0, 0, math.rad(45)))
	put(root, "Crest", V3(0.3, 2.0, 2.6), V3(0, 10.2, 0.4), SILVER, nil, CFrame.Angles(0.35, 0, 0))
	put(root, "CrestN", V3(0.34, 0.15, 2.4), V3(0, 11.15, 0.75), NEON, NM, CFrame.Angles(0.35, 0, 0))
	for _, s in ipairs({1, -1}) do
		local eye = put(root, "Eye", V3(0.9, 0.22, 0.15), V3(s * 0.55, 8.25, -1.43), NEON, NM, CFrame.Angles(0, 0, s * 0.45))
		if not R.Eye then R.Eye = eye; light(eye, 25, 3) end
		put(root, "Horn", V3(0.25, 3.2, 0.45), V3(s * 1.0, 10.0, 0.5), SILVER, nil, CFrame.Angles(0.5, 0, -s * 0.35))
		put(root, "HornTip", V3(0.2, 0.9, 0.35), V3(s * 1.45, 11.3, 1.35), NEON, NM, CFrame.Angles(0.5, 0, -s * 0.35))
		put(root, "Jaw", V3(0.4, 0.9, 1.1), V3(s * 1.15, 7.6, -0.7), GUN, nil, CFrame.Angles(0, s * 0.2, 0))
		put(root, "Cheek", V3(0.25, 0.9, 0.7), V3(s * 1.3, 8.1, -0.4), GUN, nil, CFrame.Angles(0, 0, s * 0.15))
		put(root, "EarGlow", V3(0.12, 0.5, 0.4), V3(s * 1.45, 8.2, 0.2), NEON, NM)
		put(root, "Antenna", V3(0.1, 2.4, 0.1), V3(s * 1.5, 10.0, -0.5), NEON, NM, CFrame.Angles(0, 0, -s * 0.2))
		put(root, "HeadFin", V3(0.25, 0.25, 2.4), V3(s * 1.35, 8.2, 1.6), NEON, NM)
	end

	-- เครื่องยนต์หลัง
	for _, s in ipairs({1, -1}) do
		put(root, "Engine", V3(0.8, 2.4, 2.4), V3(s * 1.5, 4.0, 4.0), BLACK, nil, face90, cyl)
		put(root, "EngineIn", V3(0.5, 1.6, 1.6), V3(s * 1.5, 4.0, 4.5), NEON, NM, face90, cyl)
		R.Thr[#R.Thr + 1] = put(root, "Thr", V3(0.9, 0.6, 0.9), V3(s * 1.5, 2.0, 3.6), GUN)
	end
	R.Seat = put(root, "Seat", V3(1, 1, 1), V3(0, 4.2, 0.3), BLACK)
	R.Seat.Transparency = 1
	R.Seat:SetAttribute("Keep", true)

	----------------------------------------------------------------
	-- แขน (ขวา = ดาบแดง, ซ้าย = ปืนใหญ่) + ขา
	----------------------------------------------------------------
	local function limb(name, pos)
		local pv = mk(name, V3(0.3, 0.3, 0.3), BLACK)
		pv.Transparency = 1
		pv:SetAttribute("Keep", true)
		local c0 = CF(pos * SC)
		R.J[name] = {w = weld(root, pv, c0), c0 = c0}
		return pv
	end
	for _, d in ipairs({{"R", 1}, {"L", -1}}) do
		local n, s = d[1], d[2]
		local a = limb(n .. "Arm", V3(s * 4.4, 5.0, 0))
		put(a, "UArm", V3(2.0, 3.2, 2.0), V3(0, -1.8, 0), GUN)
		put(a, "UBand", V3(2.1, 0.2, 2.1), V3(0, -0.6, 0), NEON, NM)
		put(a, "Elbow", V3(1.6, 1.6, 1.6), V3(0, -3.6, 0), SILVER, nil, nil, Enum.PartType.Ball)
		if n == "L" then
			-- ปืนใหญ่แขนซ้าย
			put(a, "FArm", V3(2.6, 3.4, 2.8), V3(0, -5.4, 0), BLACK)
			put(a, "FStripe", V3(0.3, 2.0, 2.4), V3(s * 1.45, -5.4, 0), NEON, NM)
			put(a, "CannonBody", V3(1.9, 1.9, 2.6), V3(0, -5.4, -2.4), GUN)
			put(a, "CannonBar", V3(1.1, 1.1, 3.6), V3(0, -5.4, -5.0), BLACK)
			put(a, "CannonRing1", V3(0.3, 1.6, 1.6), V3(0, -5.4, -4.0), NEON, NM, face90, cyl)
			put(a, "CannonRing2", V3(0.3, 1.6, 1.6), V3(0, -5.4, -5.2), NEON, NM, face90, cyl)
			R.Muzzle = put(a, "Muzzle", V3(0.8, 0.8, 0.4), V3(0, -5.4, -7.0), NEON, NM)
			light(R.Muzzle, 20, 2)
		else
			put(a, "FArm", V3(2.3, 3.2, 2.5), V3(0, -5.4, 0), BLACK)
			put(a, "FStripe", V3(0.3, 2.0, 2.1), V3(s * 1.2, -5.4, 0), NEON, NM)
			-- ดาบแดงนีออน
			local th = 0.5
			local rt = CFrame.Angles(th, 0, 0)
			put(a, "Grip", V3(0.45, 0.45, 2.2), V3(0, -7.46, -0.26), BLACK, nil, rt)
			put(a, "Pommel", V3(0.75, 0.75, 0.75), V3(0, -8.08, 0.88), NEON, NM, nil, Enum.PartType.Ball)
			put(a, "Guard", V3(3.4, 0.5, 0.7), V3(0, -6.83, -1.40), SILVER, nil, rt)
			for _, gs in ipairs({1, -1}) do
				put(a, "GuardTip", V3(0.5, 0.5, 1.0), V3(gs * 1.8, -6.83, -1.40), NEON, NM, rt)
			end
			put(a, "Blade", V3(0.3, 0.95, 10.6), V3(0, -4.06, -6.50), NEON, NM, rt)
			put(a, "BladeSpine", V3(0.5, 0.25, 10.8), V3(0, -3.58, -6.24), BLACK, nil, rt)
			put(a, "BladeEdge", V3(0.5, 0.2, 10.8), V3(0, -4.54, -6.76), SILVER, nil, rt)
			local tip = put(a, "BladeTip", V3(0.3, 1.0, 1.0), V3(0, -1.42, -11.33), NEON, NM, CFrame.Angles(th + math.rad(45), 0, 0))
			light(tip, 30, 3)
