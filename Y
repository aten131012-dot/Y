local function startCtl(R, char)
	local root = R.Root
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {R.Model, char}
	root.Anchored = false
	bv = Instance.new("BodyVelocity")
	bv.MaxForce = V3(1e9, 1e9, 1e9)
	bv.Velocity = V3()
	bv.Parent = root
	bg = Instance.new("BodyGyro")
	bg.MaxTorque = V3(1e9, 1e9, 1e9)
	bg.P = 15000
	bg.D = 1500
	bg.CFrame = root.CFrame
	bg.Parent = root
	local l0 = root.CFrame.LookVector
	head = V3(l0.X, 0, l0.Z)
	head = head.Magnitude > 0.01 and head.Unit or V3(0, 0, -1)
	cur = V3()
	air, vy, jumpT = false, 0, -10
	P = {la = 0, ra = 0, ll = 0, rl = 0}

	conn = RS.Heartbeat:Connect(function(dt)
		local S = N.S
		if not (R.Model.Parent and char.Parent) then return end
		local cam = workspace.CurrentCamera
		local cl = cam.CFrame
		local mv = controls and controls:GetMoveVector() or V3()
		local dashing = N.DashUntil and os.clock() < N.DashUntil
		local pos = root.Position
		local k = math.clamp(dt * 4, 0, 1)
		local w = cl:VectorToWorldSpace(V3(mv.X, 0, mv.Z))
		local flat = V3(cl.LookVector.X, 0, cl.LookVector.Z)
		if flat.Magnitude < 0.01 then flat = head end
		local tilt = 0

		----------------------------------------------------------------
		-- โหมดเครื่องบินเจ็ท
		----------------------------------------------------------------
		if S.Jet then
			local boost = N.JetBoostUntil and os.clock() < N.JetBoostUntil
			local want = JET
			if mv.Z < -0.3 then want = JET * 1.35 elseif mv.Z > 0.3 then want = JET * 0.55 end
			if boost then want = JET * 2.2 end
			jsp = jsp + (want - jsp) * math.clamp(dt * 2.5, 0, 1)
			jdir = jdir:Lerp(cl.LookVector, math.clamp(dt * 2.4, 0, 1))
			jdir = jdir.Magnitude > 0.05 and jdir.Unit or cl.LookVector
			-- กันพุ่งชนพื้น
			local gh = workspace:Raycast(pos, V3(0, -40, 0), rp)
			if gh and jdir.Y < 0.05 then
				jdir = V3(jdir.X, 0.05, jdir.Z).Unit
			end
			cur = jdir * jsp
			bv.Velocity = cur
			local roll = -math.clamp(mv.X, -1, 1) * 0.75
			bg.CFrame = CFrame.lookAt(pos, pos + jdir) * CFrame.Angles(0, 0, roll)
			local hz = V3(jdir.X, 0, jdir.Z)
			if hz.Magnitude > 0.01 then head = hz.Unit end
			return
		end

		if S.Flying then
			air, vy = false, 0
			local up = UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0
			w = w + V3(0, up, 0)
			local target = w.Magnitude > 0.05 and w.Unit * FLY or V3()
			if dashing then target = cl.LookVector * DASH end
			cur = cur:Lerp(target, k)
			head = flat.Unit
			tilt = math.rad(55) * math.clamp(-mv.Z, 0, 1)
			if dashing then tilt = math.rad(75) end
		else
			w = V3(w.X, 0, w.Z)
			if dashing and w.Magnitude < 0.05 then w = flat end
			local target = w.Magnitude > 0.05 and w.Unit * (dashing and DASH * 0.5 or WALK) or V3()
			local hz = V3(cur.X, 0, cur.Z):Lerp(target, air and k * 0.6 or k)
			local hit = workspace:Raycast(pos + V3(0, 60, 0), V3(0, -900, 0), rp)
			local want = hit and (hit.Position.Y + R.Floor) or pos.Y
			local gpt = hit and hit.Position or V3(pos.X, pos.Y - R.Floor, pos.Z)

			-- ออกตัวกระโดด
			if not air and os.clock() - jumpT < 0.25 then
				air, vy, jumpT = true, JUMP, -10
				N.Thrust(R, true)
				task.delay(0.4, function()
					if N.R == R and not N.S.Flying and not N.S.Jet and not (N.DashUntil and os.clock() < N.DashUntil) then
						N.Thrust(R, false)
					end
				end)
				N.Ring(gpt + V3(0, 1, 0), 130, 0.6, NEON)
				N.Dust(gpt + V3(0, 3, 0), 30)
				N.Shake(0.3, 1)
			end
			-- เดินตกขอบ = ตกด้วยแรงโน้มถ่วง
			if not air and pos.Y - want > 6 then
				air, vy = true, 0
			end

			if air then
				vy = vy - GRAV * dt
				if vy <= 0 and pos.Y + vy * dt <= want then
					air, vy = false, 0
					N.Ring(gpt + V3(0, 1, 0), 170, 0.8, NEON)
					N.Dust(gpt + V3(0, 3, 0), 45)
					N.Shake(0.5, 1.6)
					cur = V3(hz.X, math.clamp((want - pos.Y) * 6, -150, 150), hz.Z)
				else
					cur = V3(hz.X, vy, hz.Z)
				end
			else
				cur = V3(hz.X, math.clamp((want - pos.Y) * 6, -150, 150), hz.Z)
			end

			if w.Magnitude > 0.05 then
				local nh = head:Lerp(w.Unit, math.clamp(dt * 3, 0, 1))
				if nh.Magnitude > 0.05 then head = nh.Unit else head = w.Unit end
			end
		end
		bv.Velocity = cur
		bg.CFrame = CFrame.lookAt(pos, pos + head) * CFrame.Angles(-tilt, 0, 0)

		-- ท่าทางแขนขา
		local sp = V3(cur.X, 0, cur.Z).Magnitude
		local la, ra, ll, rl = 0, 0, 0, 0
		if S.Flying then
			la, ra, ll, rl = -0.6, -0.6, -0.4, -0.3
			if dashing then la, ra = -1.1, -1.1 end
		elseif air then
			if vy > 0 then
				la, ra, ll, rl = -0.8, -0.8, 0.9, 0.5
			else
				la, ra, ll, rl = 0.7, 0.7, 0.25, 0.25
			end
		elseif sp > 2 then
			ph = ph + dt * sp * 0.12
			local sw = math.sin(ph)
			ll, rl, la, ra = sw * 0.6, -sw * 0.6, -sw * 0.45, sw * 0.45
		end
		local an = N.Anim
		if an and os.clock() < an.t then la, ra = an.la, an.ra end
		local f = math.clamp(dt * 10, 0, 1)
		P.la = P.la + (la - P.la) * f
		P.ra = P.ra + (ra - P.ra) * f
		P.ll = P.ll + (ll - P.ll) * f
		P.rl = P.rl + (rl - P.rl) * f
		N.Pose(R, P.la, P.ra, P.ll, P.rl)
	end)
end

function N.Ride()
	local S = N.S
	if not S.Landed or S.Riding or S.Busy then return end
	local R = N.R
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp and R) then return end
	S.Busy = true
	N.Refresh()
	hum.PlatformStand = true
	hrp.Anchored = true
	local from = hrp.CFrame
	local t0 = os.clock()
	while true do
		local a = math.min((os.clock() - t0) / 1.2, 1)
		local e = a * a * (3 - 2 * a)
		local toCF = R.Seat.CFrame
		local p = from.Position:Lerp(toCF.Position, e) + V3(0, math.sin(a * math.pi) * 25, 0)
		hrp.CFrame = CF(p) * from.Rotation:Lerp(toCF.Rotation, e)
		if a >= 1 then break end
		RS.Heartbeat:Wait()
	end
	hrp.CFrame = R.Seat.CFrame
	weld = Instance.new("Weld")
	weld.Part0 = R.Seat
	weld.Part1 = hrp
	weld.C0 = CF()
	weld.Parent = hrp
	hrp.Anchored = false
	oldZoom = {lp.CameraMinZoomDistance, lp.CameraMaxZoomDistance}
	lp.CameraMaxZoomDistance = 300
	lp.CameraMinZoomDistance = 70
	startCtl(R, char)
	S.Riding = true
	S.Busy = false
	N.Refresh()
end

function N.Dismount()
	local S = N.S
	if not S.Riding or S.Busy or S.Jet then return end
	S.Busy = true
	S.Flying = false
	N.Refresh()
	local R = N.R
	stopCtl()
	N.Thrust(R, false)
	N.WingsTo(R, 0, 0.6)
	N.Pose(R, 0, 0, 0, 0)
	local root = R.Root
	root.Anchored = true
	local from = root.CFrame
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {R.Model, lp.Character}
	local hit = workspace:Raycast(from.Position + V3(0, 60, 0), V3(0, -900, 0), rp)
	local gy = hit and hit.Position.Y or (from.Position.Y - R.Floor)
	local lk = from.LookVector
	local fl = V3(lk.X, 0, lk.Z)
	fl = fl.Magnitude > 0.01 and fl.Unit or V3(0, 0, -1)
	local pos = V3(from.Position.X, gy + R.Floor, from.Position.Z)
	local to = CFrame.lookAt(pos, pos + fl)
	local t0 = os.clock()
	while true do
		local a = math.min((os.clock() - t0) / 0.7, 1)
		root.CFrame = from:Lerp(to, a * a)
		if a >= 1 then break end
		RS.Heartbeat:Wait()
	end
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if weld then weld:Destroy() weld = nil end
	if hrp then hrp.CFrame = to * CF(0, 3 - R.Floor, -9 * N.SCALE) end
	if hum then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	restoreZoom()
	S.Riding = false
	S.Busy = false
	N.Refresh()
end

function N.ToggleFly()
	local S = N.S
	if not S.Riding or S.Busy or S.Jet then return end
	local R = N.R
	S.Flying = not S.Flying
	air, vy = false, 0
	if S.Flying then
		N.WingsTo(R, 1, 0.6)
		N.Thrust(R, true)
		cur = cur + V3(0, 60, 0)
	else
		N.WingsTo(R, 0, 0.6)
		N.Thrust(R, false)
	end
	N.Refresh()
end

-- แปลงร่าง หุ่น <-> เครื่องบินเจ็ท
function N.Transform()
	local S = N.S
	if not S.Riding or S.Busy then return end
	local R = N.R
	if not R then return end
	local toJet = not S.Jet
	S.Busy = true
	N.Refresh()
	N.Ring(R.Root.Position, 160, 0.6, NEON)
	N.Shake(0.7, 1.5)
	N.WingsTo(R, toJet and 0 or 1, 0.35)
	N.Thrust(R, false)
	task.wait(0.4)
	if not (N.R == R and R.Model.Parent) then return end
	N.SetForm(R, toJet)
	if toJet then
		S.Jet, S.Flying = true, false
		air, vy = false, 0
		jdir = R.Root.CFrame.LookVector
		jsp = 160
		cur = jdir * jsp
	else
		S.Jet, S.Flying = false, true
		N.WingsTo(R, 1, 0.4)
		N.Pose(R, -0.6, -0.6, -0.4, -0.3)
		local hz = V3(jdir.X, 0, jdir.Z)
		head = hz.Magnitude > 0.01 and hz.Unit or head
	end
	N.Thrust(R, true)
	N.Ring(R.Root.Position, 220, 0.8, Color3.fromRGB(255, 120, 120))
	N.Dust(R.Root.Position, 40)
	N.Shake(0.5, 1.5)
	S.Busy = false
	N.Refresh()
end

