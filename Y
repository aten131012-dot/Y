-- 1) ปืนกล: ยิงกระสุนแดงจากปืนที่ปีกทั้งสองข้าง 2 วินาที
----------------------------------------------------------------
local bullets = {}
local loop

local function ensureLoop()
	if loop then return end
	loop = RS.Heartbeat:Connect(function(dt)
		for i = #bullets, 1, -1 do
			local b = bullets[i]
			local step = b.dir * 450 * dt
			local hit = workspace:Raycast(b.pos, step, b.rp)
			if hit then
				N.Flash(hit.Position, 12, 0.25)
				b.p:Destroy()
				table.remove(bullets, i)
			elseif os.clock() - b.t > 1.4 then
				b.p:Destroy()
				table.remove(bullets, i)
			else
				b.pos = b.pos + step
				b.p.CFrame = CFrame.lookAt(b.pos, b.pos + b.dir)
			end
		end
		if #bullets == 0 then
			loop:Disconnect()
			loop = nil
		end
	end)
end

local function machinegun()
	local R = N.R
	local rp = N.RayParams(R)
	local DUR, RATE = 2.0, 24
	N.Shake(DUR, 0.5)
	local t0 = os.clock()
	local n = 0
	while os.clock() - t0 < DUR do
		if not alive(R) then return end
		n = n + 1
		local gun = R.JetGuns[(n % #R.JetGuns) + 1]
		local o = gun.Position + gun.CFrame.LookVector * 2
		local aim = N.CamAim(rp)
		local spread = V3(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 0.05
		local dir = ((aim - o).Unit + spread).Unit
		local p = newPart(nil, NEON, NM, 0, V3(0.6, 0.6, 7))
		p.CFrame = CFrame.lookAt(o, o + dir)
		bullets[#bullets + 1] = {p = p, pos = o, dir = dir, rp = rp, t = os.clock()}
		N.Flash(o, 5, 0.1)
		ensureLoop()
		task.wait(1 / RATE)
	end
end

