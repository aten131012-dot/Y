local function shield()
	local R = N.R
	local S = N.S
	if S.Shield then return end
	S.Shield = true
	local DUR = 6
	local s = Instance.new("Part")
	s.Name = "Shield"
	s.Shape = Enum.PartType.Ball
	s.Material = Enum.Material.ForceField
	s.Color = NEON
	s.Transparency = 0.35
	s.Size = V3(10, 10, 10)
	s.Anchored = false
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.Massless = true
	s.Parent = workspace
	local w = Instance.new("Weld")
	w.Part0 = R.Root
	w.Part1 = s
	w.C0 = CF(0, 4.2 * N.SCALE, 0)
	w.Parent = s
	local lt = Instance.new("PointLight", s)
	lt.Color = NEON
	lt.Range = 50
	lt.Brightness = 3
	N.Ring(R.Root.Position, 200, 0.7, NEON)
	N.Flash(R.Root.Position + V3(0, 10, 0), 90, 0.5)
	N.Shake(0.4, 1)
	TS:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back), {Size = V3(75, 75, 75)}):Play()
	local t0 = os.clock()
	while os.clock() - t0 < DUR do
		if not (N.R == R and R.Model.Parent) then break end
		local el = os.clock() - t0
		local left = DUR - el
		local pulse = 0.45 + math.sin(el * 6) * 0.12
		if left < 1.2 then pulse = pulse + (math.floor(el * 10) % 2) * 0.3 end -- กะพริบเตือนใกล้หมด
		s.Transparency = math.clamp(pulse, 0.2, 0.95)
		RS.Heartbeat:Wait()
	end
	if s.Parent then
		TS:Create(s, TweenInfo.new(0.3), {Size = V3(95, 95, 95), Transparency = 1}):Play()
		Debris:AddItem(s, 0.35)
		if N.R == R and R.Model.Parent then N.Ring(R.Root.Position, 160, 0.5, NEON) end
	end
	S.Shield = false
end

