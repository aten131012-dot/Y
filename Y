local function pop(key, show)
	local b = N.Btn[key]
	if b.Visible == show then return end
	b.Visible = show
	if show then
		local p, o = N.Pos[key], N.Off[key]
		b.Position = UDim2.new(p.X.Scale, p.X.Offset + o.X, p.Y.Scale, p.Y.Offset + o.Y)
		TS:Create(b, TweenInfo.new(0.35, Enum.EasingStyle.Back), {Position = p}):Play()
	end
end

function N.Refresh()
	local S = N.S
	local idle = not S.Busy
	local mode = S.Jet and "jet" or "robot"
	local names = N.Names[mode]
	if N.Mode ~= mode then
		N.Mode = mode
		for i = 1, 6 do
			local k = "s" .. i
			local b = N.Btn[k]
			N.CoolTok[k] = (N.CoolTok[k] or 0) + 1
			b.Text = names[i] or ""
			b:SetAttribute("Base", names[i] or "")
			b.TextColor3 = WHITE
			N.Stroke[k].Color = NEON
		end
	end
	local show = {
		call = idle and not S.Called,
		ride = idle and S.Landed and not S.Riding,
		dismiss = idle and S.Landed and not S.Riding,
		dismount = idle and S.Riding and not S.Jet,
		fly = idle and S.Riding and not S.Jet,
		jet = idle and S.Riding,
	}
	for i = 1, 6 do show["s" .. i] = idle and S.Riding and names[i] ~= nil end
	for k in pairs(N.Btn) do pop(k, show[k] == true) end
	local f = N.Btn.fly
	f.Text = S.Flying and "หยุดบิน" or "บิน"
	f.BackgroundColor3 = S.Flying and NEON or BG
	N.Btn.jet.Text = S.Jet and "แปลงเป็นหุ่น" or "แปลงเจ็ท"
end

-- คูลดาวน์: ชื่อสกิล + เลขวินาทีนับถอยหลัง
function N.Cool(key, sec)
	local b, st = N.Btn[key], N.Stroke[key]
	local base = b:GetAttribute("Base")
	N.CoolTok[key] = (N.CoolTok[key] or 0) + 1
	local tok = N.CoolTok[key]
	task.spawn(function()
		local t0 = os.clock()
		b.TextColor3 = GREY
		st.Color = GREY
		while true do
			if N.CoolTok[key] ~= tok then return end
			local left = sec - (os.clock() - t0)
			if left <= 0 then break end
			b.Text = base .. "\n" .. string.format("%.1f", left)
			task.wait(0.1)
		end
		b.Text = base
		b.TextColor3 = WHITE
		st.Color = NEON
	end)
end

local function bind(key, fn)
	N.Btn[key].Activated:Connect(function()
		local f = N[fn]
		if f then f() end
	end)
end
