local function alive(R)
	return N.R == R and R.Model.Parent and N.S.Jet
end

local function newPart(shape, color, mat, tr, size)
	local p = Instance.new("Part")
	if shape then p.Shape = shape end
	p.Material = mat
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = tr
	p.Size = size
	p.Parent = workspace
	return p
end

