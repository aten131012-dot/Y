local function bomb(from, rp)
	local h = workspace:Raycast(from, V3(0, -1500, 0), rp)
	local tp = h and h.Position or (from - V3(0, 300, 0))
	local m = newPart(Enum.PartType.Ball, NEON, NM, 0, V3(4, 4, 4))
	m.Position = from
	local lt = Instance.new("PointLight", m)
	lt.Color = NEON
	lt.Range = 25
	lt.Brightness = 3
	local a0 = Instance.new("Attachment", m)
	a0.Position = V3(2, 0, 0)
	local a1 = Instance.new("Attachment", m)
	a1.Position = V3(-2, 0, 0)
	local tr = Instance.new("Trail", m)
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.5
	tr.LightEmission = 1
	tr.Color = ColorSequence.new(NEON)
	tr.Transparency = NumberSequence.new(0, 1)
	local fall = math.clamp((from.Y - tp.Y) / 250, 0.4, 2.5)
	local tw = TS:Create(m, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{Position = tp + V3(0, 2, 0)})
	tw.Completed:Once(function()
		m:Destroy()
		N.Explode(tp, 34)
		N.Ring(tp + V3(0, 1, 0), 140, 0.7, NEON)
		N.Dust(tp + V3(0, 2, 0), 30)
		N.Shake(0.4, 1.5)
	end)
	tw:Play()
end

local function carpet()
	local R = N.R
	local rp = N.RayParams(R)
	for _ = 1, 8 do
		if not alive(R) then return end
		bomb(R.Root.Position - V3(0, 6, 0), rp)
		task.wait(0.2)
	end
end

