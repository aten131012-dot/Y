local function slashOne(origin, dir, roll, rp)
	local p = newPart(Enum.PartType.Cylinder, NEON, NM, 0.15, V3(1.5, 14, 70))
	local inner = Instance.new("Part")
	inner.Shape = Enum.PartType.Cylinder
	inner.Material = NM
	inner.Color = PALE
	inner.Size = V3(2, 8, 60)
	inner.CanCollide = false
	inner.CanQuery = false
	inner.CanTouch = false
	inner.Massless = true
	inner.Parent = p
	local w = Instance.new("Weld")
	w.Part0 = p
	w.Part1 = inner
	w.Parent = inner
	local pos = origin
	local t0 = os.clock()
	local c
	c = RS.Heartbeat:Connect(function(dt)
		local step = dir * 260 * dt
		local hit = workspace:Raycast(pos, step, rp)
		if hit or os.clock() - t0 > 2.2 then
			c:Disconnect()
			local at = hit and hit.Position or pos
			p:Destroy()
			explode(at, 30)
			N.Ring(at + V3(0, 1, 0), 120, 0.6, NEON)
			N.Shake(0.5, 2)
			return
		end
		pos = pos + step
		p.CFrame = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(roll, 0, 0)
	end)
end

