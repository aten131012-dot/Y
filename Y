repeat task.wait() until _G.NXG and _G.NXG.Ready and _G.NXG.Call
local N = _G.NXG
local CF, V3 = CFrame.new, Vector3.new

local WALK, FLY, DASH = 60, 170, 320 -- ความเร็วเดิน / บิน / พุ่ง (แก้ได้)
local JET = 230 -- ความเร็วเครื่องบินเจ็ท (แก้ได้)
local JUMP, GRAV = 150, 220 -- แรงกระโดด / แรงโน้มถ่วง
local NEON = Color3.fromRGB(255, 30, 50)

local controls
pcall(function()
	controls = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
end)

local bv, bg, conn, weld, oldZoom
local cur = V3()
local head = V3(0, 0, -1)
local ph = 0
local vy, air, jumpT = 0, false, -10
local jdir, jsp = V3(0, 0, -1), 0
local P = {la = 0, ra = 0, ll = 0, rl = 0}

