local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local lp = Players.LocalPlayer
repeat task.wait() until _G.NXG and _G.NXG.Ready and _G.NXG.Build
local N = _G.NXG
local CF, V3 = CFrame.new, Vector3.new

local function ring(pos, maxSize, dur, color)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 0.35
	p.Size = V3(1, 10, 10)
	p.CFrame = CF(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace
	TS:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = V3(1, maxSize, maxSize), Transparency = 1}):Play()
	Debris:AddItem(p, dur + 0.1)
end

local function dust(pos, n)
	local a = Instance.new("Part")
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.Transparency = 1
	a.Size = V3(1, 1, 1)
	a.CFrame = CF(pos)
	a.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(140, 130, 120))
	e.Rate = 0
	e.Lifetime = NumberRange.new(1.5, 3)
	e.Speed = NumberRange.new(40, 90)
	e.SpreadAngle = Vector2.new(80, 80)
	e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 40)})
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = a
	e:Emit(n)
	Debris:AddItem(a, 4)
end

function N.Shake(sec, amp)
	local t0 = os.clock()
	local name = "NXG_Shake" .. tostring(t0) .. tostring(math.random(1, 99999))
	RS:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
		local k = (os.clock() - t0) / sec
		if k >= 1 then
			RS:UnbindFromRenderStep(name)
			return
		end
		local a = amp * (1 - k) ^ 2
		local cam = workspace.CurrentCamera
		cam.CFrame = cam.CFrame * CF((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0)
	end)
end

N.Ring = ring
N.Dust = dust

function N.Call()
	local S = N.S
	if S.Called then return end
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	S.Called, S.Busy = true, true
	N.Refresh()

	local R = N.Build()
	N.R = R
	local look = hrp.CFrame.LookVector
	local fwd = V3(look.X, 0, look.Z)
	fwd = fwd.Magnitude > 0.01 and fwd.Unit or V3(0, 0, -1)
	local gp = hrp.Position + fwd * 95
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {char, R.Model}
	local hit = workspace:Raycast(V3(gp.X, hrp.Position.Y + 300, gp.Z), V3(0, -900, 0), rp)
	local gy = hit and hit.Position.Y or (hrp.Position.Y - 3)
	local landPos = V3(gp.X, gy + R.Floor, gp.Z)
	local face = -fwd
	local function pose(pos, lean)
		return CFrame.lookAt(pos, pos + face) * CFrame.Angles(-lean, 0, 0)
	end

	local start = landPos - face * 170 + V3(0, 520, 0)
	R.Root.Anchored = true
	R.Root.CFrame = pose(start, math.rad(70))
	R.Model.Parent = workspace
	N.WingPose(R, 1)
	N.Pose(R, -0.6, -0.6, -0.4, -0.3)
	N.Thrust(R, true)

	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local camA = hrp.Position + V3(0, 4, 0)
	local side = face:Cross(V3(0, 1, 0)).Unit
	local gpos = landPos - V3(0, R.Floor, 0)
	local camB = gpos + side * 120 + face * 25 + V3(0, 14, 0)

	local T = 5.2
	local t0 = os.clock()
	while true do
		local a = (os.clock() - t0) / T
		if a >= 1 then break end
		local e = 1 - (1 - a) ^ 2.4
		local pos = start:Lerp(landPos, e)
		local lean = math.rad(70) * (1 - math.min(a / 0.85, 1))
		R.Root.CFrame = pose(pos, lean)
		local s = math.clamp((a - 0.5) / 0.2, 0, 1)
		s = s * s * (3 - 2 * s)
		cam.CFrame = CFrame.lookAt(camA:Lerp(camB, s), pos)
		RS.RenderStepped:Wait()
	end

	R.Root.CFrame = pose(landPos, 0)
	N.Thrust(R, false)
	N.WingsTo(R, 0, 1.2)
	N.Pose(R, 0, 0, 0, 0)
	ring(gpos + V3(0, 1, 0), 330, 1.1, Color3.fromRGB(120, 110, 100))
	task.delay(0.2, function()
		ring(gpos + V3(0, 1, 0), 220, 1.0, Color3.fromRGB(255, 30, 50))
	end)
	dust(gpos + V3(0, 3, 0), 90)

	local t1 = os.clock()
	while os.clock() - t1 < 2.2 do
		local k = os.clock() - t1
		local amp = 3 * (1 - k / 2.2) ^ 2
		local cp = camB + side * (k * 3)
		cam.CFrame = CFrame.lookAt(
			cp + V3((math.random() - 0.5) * amp, (math.random() - 0.5) * amp, 0), landPos)
		RS.RenderStepped:Wait()
	end
	cam.CameraType = Enum.CameraType.Custom
	S.Landed = true
	S.Busy = false
	N.Refresh()
end

function N.Dismiss()
	local S = N.S
	if not S.Landed or S.Riding or S.Busy then return end
	S.Busy = true
	N.Refresh()
	local R = N.R
	local from = R.Root.CFrame
	N.WingsTo(R, 1, 0.8)
	N.Thrust(R, true)
	N.Pose(R, -0.6, -0.6, -0.4, -0.3)
	dust(from.Position - V3(0, R.Floor - 3, 0), 60)
	task.wait(0.8)
	local t0 = os.clock()
	while os.clock() - t0 < 3 do
		local a = (os.clock() - t0) / 3
		R.Root.CFrame = from * CF(0, 600 * a * a, 0)
		RS.Heartbeat:Wait()
	end
	R.Model:Destroy()
	N.R = nil
	S.Called, S.Landed, S.Busy = false, false, false
	N.Refresh()
end
