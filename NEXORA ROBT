-- 9) หลุมดำ: ลูกบอลดำลอยกลางอากาศ ดูดแสงเข้ามา แล้วยุบตัวระเบิดใหญ่
----------------------------------------------------------------
local function blackhole()
	local R = N.R
	local rp = N.RayParams(R)
	local g = groundAt(N.CamAim(rp), rp)
	local c = g + V3(0, 70, 0)
	N.Anim = {t = os.clock() + 4.4, la = 1.6, ra = 1.6}
	N.Snd("bass", 2.4, 0.5)
	N.Snd("ping", 1.5, 0.5)
	N.Shake(1, 1)

	local core = newPart(Enum.PartType.Ball, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, 0, V3(1, 1, 1))
	local shell = newPart(Enum.PartType.Ball, NEON, Enum.Material.ForceField, 0.35, V3(1, 1, 1))
	core.Position, shell.Position = c, c
	local lt = Instance.new("PointLight", core)
	lt.Color = NEON
	lt.Range = 120
	lt.Brightness = 6
	TS:Create(core, TweenInfo.new(1.0, Enum.EasingStyle.Back), {Size = V3(46, 46, 46)}):Play()
	TS:Create(shell, TweenInfo.new(1.0, Enum.EasingStyle.Back), {Size = V3(62, 62, 62)}):Play()

	local orbs = {}
	for i = 1, 12 do
		orbs[i] = newPart(Enum.PartType.Ball, (i % 2 == 0) and NEON or GLOW, NM, 0.1, V3(7, 7, 7))
	end
	local tilt = CFrame.Angles(0.45, 0, 0.2)
	local t0, lastR = os.clock(), -1
	local DUR = 3.2
	while true do
		local el = os.clock() - t0
		if el >= DUR or not alive(R) then break end
		for i, o in ipairs(orbs) do
			local a = el * 5 + i * (2 * PI / 12)
			local r = 75 + math.sin(el * 3 + i) * 12
			o.Position = c + (tilt * V3(math.cos(a) * r, 0, math.sin(a) * r))
		end
		-- เส้นแสงถูกดูดเข้าหาศูนย์กลาง
		for _ = 1, 3 do
			local d = V3(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
			if d.Magnitude < 0.05 then d = V3(0, 1, 0) end
			d = d.Unit
			local from = c + d * (150 + math.random() * 80)
			local s = newPart(nil, NEON, NM, 0.1, V3(1.2, 1.2, 12))
			s.CFrame = CFrame.lookAt(from, c)
			TS:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{CFrame = CFrame.lookAt(c, c - d), Transparency = 1}):Play()
			Debris:AddItem(s, 0.6)
		end
		if el - lastR > 0.5 then
			lastR = el
			N.Ring(g + V3(0, 1, 0), 120 + el * 40, 0.8, NEON)
			N.Shake(0.3, 0.8)
		end
		RS.Heartbeat:Wait()
	end
	for _, o in ipairs(orbs) do o:Destroy() end

	-- ยุบตัว แล้วระเบิด
	TS:Create(core, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = V3(2, 2, 2)}):Play()
	TS:Create(shell, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = V3(2, 2, 2)}):Play()
	task.wait(0.4)
	core:Destroy()
	shell:Destroy()
	N.Explode(c, 120)
	N.Flash(c, 340, 1.0)
	N.Ring(c, 600, 1.2, NEON)
	N.Ring(g + V3(0, 1, 0), 520, 1.2, NEON)
	task.delay(0.15, function() N.Ring(g + V3(0, 1, 0), 380, 1.0, GLOW) end)
	task.delay(0.3, function() N.Ring(g + V3(0, 1, 0), 240, 0.9, PALE) end)
	N.Burst(c, 80, NEON, 300, 1.1)
	N.Dust(g + V3(0, 3, 0), 120)
	N.Snd("boom", 3, 0.4, c)
	N.Snd("boom", 2.5, 0.7, c)
	N.Shake(2.2, 5)
end

