function N.Skill(i)
	local S = N.S
	if not S.Riding or S.Busy or not N.R then return end
	local list = S.Jet and N.JetCDT or CDT
	local ct = list and list[i]
	if not ct then return end
	local key = (S.Jet and "J" or "R") .. i
	if cd[key] and os.clock() < cd[key] then return end
	cd[key] = os.clock() + ct
	N.Cool(KEYS[i], ct)
	if S.Jet then
		if N.JetSkill then task.spawn(N.JetSkill, i) end
	elseif i == 3 then
		dash()
	else
		task.spawn(FN[i])
	end
