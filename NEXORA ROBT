local RS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
repeat task.wait() until _G.NXG and _G.NXG.Ready and _G.NXG.Skill and _G.NXG.Flash and _G.NXG.FireBeams
local N = _G.NXG
local CF, V3 = CFrame.new, Vector3.new
local PI = math.pi

local NEON = Color3.fromRGB(255, 10, 30)
local PALE = Color3.fromRGB(255, 190, 170)
local GLOW = Color3.fromRGB(255, 70, 50)
local NM = Enum.Material.Neon

local function newPart(shape, color, mat, tr, size)
	local p = Instance.new("Part")
	if shape then p.Shape = shape end
	p.Material = mat
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = tr
	p.Size = size
	p.Parent = workspace
	return p
end

local function alive(R)
	return N.R == R and R.Model.Parent
end

local function groundAt(pos, rp)
	local h = workspace:Raycast(pos + V3(0, 400, 0), V3(0, -1200, 0), rp)
	return h and h.Position or pos
end

