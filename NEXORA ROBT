local function ring(pos, maxSize, dur, color)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 0.35
	p.Size = V3(1, 10, 10)
	p.CFrame = CF(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = workspace
	TS:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = V3(1, maxSize, maxSize), Transparency = 1}):Play()
	Debris:AddItem(p, dur + 0.1)
end

local function dust(pos, n)
	local a = Instance.new("Part")
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.Transparency = 1
	a.Size = V3(1, 1, 1)
	a.CFrame = CF(pos)
	a.Parent = workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(140, 130, 120))
	e.Rate = 0
	e.Lifetime = NumberRange.new(1.5, 3)
	e.Speed = NumberRange.new(40, 90)
	e.SpreadAngle = Vector2.new(80, 80)
	e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 40)})
	e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
	e.EmissionDirection = Enum.NormalId.Top
	e.Parent = a
	e:Emit(n)
	Debris:AddItem(a, 4)
end

-- เศษแสงพุ่งออกรอบทิศ
function N.Burst(pos, n, color, dist, dur)
	for _ = 1, n do
		local d = V3(math.random() - 0.5, math.random() * 0.8 - 0.1, math.random() - 0.5)
		if d.Magnitude < 0.05 then d = V3(0, 1, 0) end
		d = d.Unit
		local p = Instance.new("Part")
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 0.1
		p.Size = V3(0.8, 0.8, 5 + math.random() * 5)
		p.CFrame = CFrame.lookAt(pos, pos + d)
		p.Parent = workspace
		local to = pos + d * dist * (0.5 + math.random() * 0.5)
		TS:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{CFrame = CFrame.lookAt(to, to + d), Transparency = 1}):Play()
		Debris:AddItem(p, dur + 0.1)
	end
end

function N.Shake(sec, amp)
	local t0 = os.clock()
	local name = "NXG_Shake" .. tostring(t0) .. tostring(math.random(1, 99999))
	RS:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
		local k = (os.clock() - t0) / sec
		if k >= 1 then
			RS:UnbindFromRenderStep(name)
			return
		end
		local a = amp * (1 - k) ^ 2
		local cam = workspace.CurrentCamera
		cam.CFrame = cam.CFrame * CF((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0)
	end)
end

N.Ring = ring
N.Dust = dust

