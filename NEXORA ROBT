local function missile(origin, dir0, aim, rp, speed)
	speed = speed or 200
	local m = newPart(nil, Color3.fromRGB(60, 62, 72), Enum.Material.Metal, 0, V3(1.2, 1.2, 6))
	m.CFrame = CFrame.lookAt(origin, origin + dir0)
	local nose = Instance.new("Part")
	nose.Size = V3(1.2, 1.2, 1.5)
	nose.Color = NEON
	nose.Material = NM
	nose.CanCollide = false
	nose.CanQuery = false
	nose.CanTouch = false
	nose.Massless = true
	nose.Parent = m
	local w = Instance.new("Weld")
	w.Part0 = m
	w.Part1 = nose
	w.C0 = CF(0, 0, -3.2)
	w.Parent = nose
	local lt = Instance.new("PointLight", m)
	lt.Color = NEON
	lt.Range = 18
	lt.Brightness = 3
	local a0 = Instance.new("Attachment", m)
	a0.Position = V3(0.6, 0, 3)
	local a1 = Instance.new("Attachment", m)
	a1.Position = V3(-0.6, 0, 3)
	local tr = Instance.new("Trail", m)
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.9
	tr.LightEmission = 1
	tr.Color = ColorSequence.new(Color3.fromRGB(255, 190, 120), Color3.fromRGB(120, 30, 30))
	tr.Transparency = NumberSequence.new(0, 1)

	local pos, dir = origin, dir0
	local t0 = os.clock()
	local c
	c = RS.Heartbeat:Connect(function(dt)
		local want = aim - pos
		if os.clock() - t0 > 0.25 and want.Magnitude > 1 then
			dir = dir:Lerp(want.Unit, math.clamp(dt * 3.5, 0, 1)).Unit
		end
		local step = dir * speed * dt
		local hit = workspace:Raycast(pos, step, rp)
		if hit or os.clock() - t0 > 4 then
			c:Disconnect()
			local at = hit and hit.Position or pos
			m:Destroy()
			explode(at, 22)
			N.Ring(at + V3(0, 1, 0), 70, 0.5, NEON)
			return
		end
		pos = pos + step
		m.CFrame = CFrame.lookAt(pos, pos + dir)
	end)
end
