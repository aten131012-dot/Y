	p.Material = mat
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = tr
	p.Size = size
	p.Parent = workspace
	return p
end

local function flash(pos, size, dur)
