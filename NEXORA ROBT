local function camAim(rp)
	local cam = workspace.CurrentCamera
	local cp, lv = cam.CFrame.Position, cam.CFrame.LookVector
	local hit = workspace:Raycast(cp, lv * 1500, rp)
	return hit and hit.Position or (cp + lv * 1500)
end

local function newPart(shape, color, mat, tr, size)
	local p = Instance.new("Part")
