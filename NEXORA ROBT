function N.Call()
	local S = N.S
	if S.Called then return end
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	S.Called, S.Busy = true, true
	N.Refresh()

	local R = N.Build()
	N.R = R
	local look = hrp.CFrame.LookVector
	local fwd = V3(look.X, 0, look.Z)
	fwd = fwd.Magnitude > 0.01 and fwd.Unit or V3(0, 0, -1)
	local gp = hrp.Position + fwd * 95
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {char, R.Model}
	local hit = workspace:Raycast(V3(gp.X, hrp.Position.Y + 300, gp.Z), V3(0, -900, 0), rp)
	local gy = hit and hit.Position.Y or (hrp.Position.Y - 3)
	local landPos = V3(gp.X, gy + R.Floor, gp.Z)
	local gpos = landPos - V3(0, R.Floor, 0)
	local face = -fwd
	local function pose(pos, lean)
		return CFrame.lookAt(pos, pos + face) * CFrame.Angles(-lean, 0, 0)
	end

	local start = landPos - face * 170 + V3(0, 520, 0)
	R.Root.Anchored = true
	R.Root.CFrame = pose(start, math.rad(70))
	R.Model.Parent = workspace
	N.WingPose(R, 1)
	N.Pose(R, -0.6, -0.6, -0.4, -0.3)
	N.Thrust(R, true)

	-- เสาแสงบอกจุดลงจอด
	local tele = Instance.new("Part")
	tele.Material = Enum.Material.Neon
	tele.Color = GLOW
	tele.Anchored = true
	tele.CanCollide = false
	tele.CanQuery = false
	tele.CanTouch = false
	tele.Transparency = 0.6
	tele.Size = V3(14, 900, 14)
	tele.Position = gpos + V3(0, 450, 0)
	tele.Parent = workspace
	Debris:AddItem(tele, 9)
	ring(gpos + V3(0, 1, 0), 170, 1.6, GLOW)
	N.Snd("ping", 1.2, 0.7)
	local fall = N.Snd("whoosh", 1.6, 0.6)

	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local camA = hrp.Position + V3(0, 4, 0)
	local side = face:Cross(V3(0, 1, 0)).Unit
	local camB = gpos + side * 120 + face * 25 + V3(0, 14, 0)

	local T = 5.2
	local t0 = os.clock()
	while true do
		local a = (os.clock() - t0) / T
		if a >= 1 then break end
		local e = 1 - (1 - a) ^ 2.4
		local pos = start:Lerp(landPos, e)
		local lean = math.rad(70) * (1 - math.min(a / 0.85, 1))
		R.Root.CFrame = pose(pos, lean)
		local s = math.clamp((a - 0.5) / 0.2, 0, 1)
		s = s * s * (3 - 2 * s)
		cam.CFrame = CFrame.lookAt(camA:Lerp(camB, s), pos)
		RS.RenderStepped:Wait()
	end

	R.Root.CFrame = pose(landPos, 0)
	N.Thrust(R, false)
	N.WingsTo(R, 0, 1.2)
	N.Pose(R, 0, 0, 0, 0)
	if fall then fall:Stop() end
	tele:Destroy()
	N.Snd("boom", 3, 0.5, gpos)
	N.Snd("boom", 2, 0.9, gpos)
	ring(gpos + V3(0, 1, 0), 330, 1.1, Color3.fromRGB(120, 110, 100))
	task.delay(0.2, function()
		ring(gpos + V3(0, 1, 0), 220, 1.0, GLOW)
	end)
	N.Burst(gpos + V3(0, 3, 0), 50, GLOW, 160, 0.9)
	dust(gpos + V3(0, 3, 0), 90)

	local t1 = os.clock()
	while os.clock() - t1 < 2.2 do
		local k = os.clock() - t1
		local amp = 3 * (1 - k / 2.2) ^ 2
		local cp = camB + side * (k * 3)
		cam.CFrame = CFrame.lookAt(
			cp + V3((math.random() - 0.5) * amp, (math.random() - 0.5) * amp, 0), landPos)
		RS.RenderStepped:Wait()
	end
	cam.CameraType = Enum.CameraType.Custom
	S.Landed = true
	S.Busy = false
	N.Refresh()
end

function N.Dismiss()
	local S = N.S
	if not S.Landed or S.Riding or S.Busy then return end
	S.Busy = true
	N.Refresh()
	local R = N.R
	local from = R.Root.CFrame
	N.WingsTo(R, 1, 0.8)
	N.Thrust(R, true)
	N.Pose(R, -0.6, -0.6, -0.4, -0.3)
	N.Snd("launch", 1.4, 0.8)
	dust(from.Position - V3(0, R.Floor - 3, 0), 60)
	task.wait(0.8)
	N.Snd("whoosh", 1.4, 0.7)
	local t0 = os.clock()
	while os.clock() - t0 < 3 do
		local a = (os.clock() - t0) / 3
		R.Root.CFrame = from * CF(0, 600 * a * a, 0)
		RS.Heartbeat:Wait()
	end
	R.Model:Destroy()
	N.R = nil
	S.Called, S.Landed, S.Busy = false, false, false
	N.Refresh()
end-- NEXORA GIANT ROBOT v5 DEMON | ไฟล์ 4/7 : ขี่ + เดิน + บิน + กระโดด + แปลงร่างเจ็ท (มีอนิเมชันไป-กลับ) + เสียงเครื่องยนต์/ก้าวเดิน
local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local lp = Players.LocalPlayer
repeat task.wait() until _G.NXG and _G.NXG.Ready and _G.NXG.Call
local N = _G.NXG
local CF, V3 = CFrame.new, Vector3.new

local WALK, FLY, DASH = 60, 170, 320 -- ความเร็วเดิน / บิน / พุ่ง (แก้ได้)
local JET = 230 -- ความเร็วเครื่องบินเจ็ท (แก้ได้)
local JUMP, GRAV = 150, 220 -- แรงกระโดด / แรงโน้มถ่วง
local NEON = Color3.fromRGB(255, 30, 50)
local GLOW = Color3.fromRGB(255, 70, 50)

local controls
pcall(function()
	controls = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
end)

local bv, bg, conn, weld, oldZoom, hum
local cur = V3()
local head = V3(0, 0, -1)
local ph = 0
local vy, air, jumpT = 0, false, -10
local jdir, jsp = V3(0, 0, -1), 0
local stepAcc = 0
local P = {la = 0, ra = 0, ll = 0, rl = 0}

-- กดกระโดดในเกม (Space / ปุ่มกระโดดมือถือ) = หุ่นกระโดดตาม
UIS.JumpRequest:Connect(function()
	local S = N.S
	if S.Riding and not S.Flying and not S.Jet and not S.Busy then
		jumpT = os.clock()
	end
end)

local function stopCtl()
	if conn then conn:Disconnect() conn = nil end
	if bv then bv:Destroy() bv = nil end
	if bg then bg:Destroy() bg = nil end
	if hum then hum:Destroy() hum = nil end
	N.Hum = nil
	N.Morph = nil
	air, vy = false, 0
end
N.StopCtl = stopCtl

local function restoreZoom()
	if oldZoom then
		lp.CameraMaxZoomDistance = oldZoom[2]
		lp.CameraMinZoomDistance = oldZoom[1]
		oldZoom = nil
	end
end

local function startCtl(R, char)
	local root = R.Root
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {R.Model, char}
	root.Anchored = false
	bv = Instance.new("BodyVelocity")
	bv.MaxForce = V3(1e9, 1e9, 1e9)
	bv.Velocity = V3()
	bv.Parent = root
	bg = Instance.new("BodyGyro")
	bg.MaxTorque = V3(1e9, 1e9, 1e9)
	bg.P = 15000
	bg.D = 1500
	bg.CFrame = root.CFrame
	bg.Parent = root
	-- เสียงเครื่องยนต์วนลูป (ดังตอนบิน/เจ็ท)
	hum = Instance.new("Sound")
	hum.SoundId = N.SFX and N.SFX.whoosh or ""
	hum.Looped = true
	hum.Volume = 0
	hum.Parent = SoundService
	hum:Play()
	N.Hum = hum
	local l0 = root.CFrame.LookVector
	head = V3(l0.X, 0, l0.Z)
	head = head.Magnitude > 0.01 and head.Unit or V3(0, 0, -1)
	cur = V3()
	air, vy, jumpT = false, 0, -10
	stepAcc = 0
	P = {la = 0, ra = 0, ll = 0, rl = 0}

	conn = RS.Heartbeat:Connect(function(dt)
		local S = N.S
		if not (R.Model.Parent and char.Parent) then return end
		local cam = workspace.CurrentCamera
		local cl = cam.CFrame
		local mv = controls and controls:GetMoveVector() or V3()
		local dashing = N.DashUntil and os.clock() < N.DashUntil
		local pos = root.Position
		local k = math.clamp(dt * 4, 0, 1)
		local w = cl:VectorToWorldSpace(V3(mv.X, 0, mv.Z))
		local flat = V3(cl.LookVector.X, 0, cl.LookVector.Z)
		if flat.Magnitude < 0.01 then flat = head end
		local tilt = 0

		-- เสียงเครื่องยนต์
		local hv = 0
		if N.Morph or S.Jet then hv = 0.9
		elseif S.Flying then hv = 0.55
		elseif dashing then hv = 0.8 end
		if hum then
			hum.Volume = hum.Volume + (hv - hum.Volume) * math.clamp(dt * 4, 0, 1)
			hum.PlaybackSpeed = 0.6 + math.min(cur.Magnitude / 300, 1) * 0.7
		end

		----------------------------------------------------------------
		-- ระหว่างแปลงร่าง: ควบคุมท่าทางด้วยค่า N.Morph
		----------------------------------------------------------------
		local m = N.Morph
		if m then
			cur = cur:Lerp(head * (m.v or 0) + V3(0, m.vy or 0, 0), k)
			bv.Velocity = cur
			bg.CFrame = CFrame.lookAt(pos, pos + head) * CFrame.Angles(-(m.pitch or 0), 0, m.roll or 0)
			P.la, P.ra, P.ll, P.rl = m.la or 0, m.ra or 0, m.ll or 0, m.rl or 0
			N.Pose(R, P.la, P.ra, P.ll, P.rl)
			return
		end

		----------------------------------------------------------------
		-- โหมดเครื่องบินเจ็ท
		----------------------------------------------------------------
		if S.Jet then
			local boost = N.JetBoostUntil and os.clock() < N.JetBoostUntil
			local rolling = N.JetRollUntil and os.clock() < N.JetRollUntil
			local want = JET
			if mv.Z < -0.3 then want = JET * 1.35 elseif mv.Z > 0.3 then want = JET * 0.55 end
			if boost then want = JET * 2.2 end
			if rolling then want = math.max(want, JET * 1.6) end
			jsp = jsp + (want - jsp) * math.clamp(dt * 2.5, 0, 1)
			jdir = jdir:Lerp(cl.LookVector, math.clamp(dt * 2.4, 0, 1))
			jdir = jdir.Magnitude > 0.05 and jdir.Unit or cl.LookVector
			local gh = workspace:Raycast(pos, V3(0, -40, 0), rp)
			if gh and jdir.Y < 0.05 then
				jdir = V3(jdir.X, 0.05, jdir.Z).Unit
			end
			cur = jdir * jsp
			bv.Velocity = cur
			local roll = -math.clamp(mv.X, -1, 1) * 0.75
			if rolling then
				roll = roll + (1 - (N.JetRollUntil - os.clock()) / 0.9) * math.pi * 2
			end
			bg.CFrame = CFrame.lookAt(pos, pos + jdir) * CFrame.Angles(0, 0, roll)
			local hz = V3(jdir.X, 0, jdir.Z)
			if hz.Magnitude > 0.01 then head = hz.Unit end
			return
		end

		if S.Flying then
			air, vy = false, 0
			local up = UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0
			w = w + V3(0, up, 0)
			local target = w.Magnitude > 0.05 and w.Unit * FLY or V3()
			if dashing then target = cl.LookVector * DASH end
			cur = cur:Lerp(target, k)
			head = flat.Unit
			tilt = math.rad(55) * math.clamp(-mv.Z, 0, 1)
			if dashing then tilt = math.rad(75) end
		else
			w = V3(w.X, 0, w.Z)
			if dashing and w.Magnitude < 0.05 then w = flat end
			local target = w.Magnitude > 0.05 and w.Unit * (dashing and DASH * 0.5 or WALK) or V3()
			local hz = V3(cur.X, 0, cur.Z):Lerp(target, air and k * 0.6 or k)
			local hit = workspace:Raycast(pos + V3(0, 60, 0), V3(0, -900, 0), rp)
			local want = hit and (hit.Position.Y + R.Floor) or pos.Y
			local gpt = hit and hit.Position or V3(pos.X, pos.Y - R.Floor, pos.Z)

			-- ออกตัวกระโดด
			if not air and os.clock() - jumpT < 0.25 then
				air, vy, jumpT = true, JUMP, -10
				N.Thrust(R, true)
				N.Snd("launch", 1.0, 1.1)
				task.delay(0.4, function()
					if N.R == R and not N.S.Flying and not N.S.Jet and not N.Morph and not (N.DashUntil and os.clock() < N.DashUntil) then
						N.Thrust(R, false)
					end
				end)
				N.Ring(gpt + V3(0, 1, 0), 130, 0.6, GLOW)
				N.Dust(gpt + V3(0, 3, 0), 30)
				N.Shake(0.3, 1)
			end
			-- เดินตกขอบ = ตกด้วยแรงโน้มถ่วง
			if not air and pos.Y - want > 6 then
				air, vy = true, 0
			end

			if air then
				local before = vy
				vy = math.max(vy - GRAV * dt, -280)
				if vy <= 0 and pos.Y + vy * dt <= want then
					air, vy = false, 0
					local imp = math.clamp(-before, 0, 300)
					N.Ring(gpt + V3(0, 1, 0), 170 + imp * 0.4, 0.8, GLOW)
					N.Dust(gpt + V3(0, 3, 0), 45)
					N.Shake(0.5, 1.6 + imp / 120)
					N.Snd("boom", math.clamp(0.6 + imp / 120, 0.6, 2.8), 0.7, gpt)
					if imp > 160 then N.Burst(gpt + V3(0, 3, 0), 30, GLOW, 120, 0.7) end
					if not S.Flying then
						N.Thrust(R, false)
						N.WingsTo(R, 0, 0.5)
					end
					cur = V3(hz.X, math.clamp((want - pos.Y) * 6, -150, 150), hz.Z)
				else
					cur = V3(hz.X, vy, hz.Z)
				end
			else
				cur = V3(hz.X, math.clamp((want - pos.Y) * 6, -150, 150), hz.Z)
				-- เสียงก้าวเดินหนัก ๆ + สั่นจอเบา ๆ
				local spd = V3(hz.X, 0, hz.Z).Magnitude
				if spd > 8 then
					stepAcc = stepAcc + spd * dt
					if stepAcc > 30 then
						stepAcc = 0
						N.Snd("step", 0.35, 0.8 + math.random() * 0.3, gpt)
						N.Shake(0.18, 0.5)
						N.Ring(gpt + V3(0, 1, 0), 36, 0.35, Color3.fromRGB(110, 100, 92))
					end
				end
			end

			if w.Magnitude > 0.05 then
				local nh = head:Lerp(w.Unit, math.clamp(dt * 3, 0, 1))
				if nh.Magnitude > 0.05 then head = nh.Unit else head = w.Unit end
			end
		end
		bv.Velocity = cur
		bg.CFrame = CFrame.lookAt(pos, pos + head) * CFrame.Angles(-tilt, 0, 0)

		-- ท่าทางแขนขา
		local sp = V3(cur.X, 0, cur.Z).Magnitude
		local la, ra, ll, rl = 0, 0, 0, 0
		if S.Flying then
			la, ra, ll, rl = -0.6, -0.6, -0.4, -0.3
			if dashing then la, ra = -1.1, -1.1 end
		elseif air then
			if vy > 0 then
				la, ra, ll, rl = -0.8, -0.8, 0.9, 0.5
			else
				la, ra, ll, rl = 0.7, 0.7, 0.25, 0.25
			end
		elseif sp > 2 then
			ph = ph + dt * sp * 0.12
			local sw = math.sin(ph)
			ll, rl, la, ra = sw * 0.6, -sw * 0.6, -sw * 0.45, sw * 0.45
		end
		local an = N.Anim
		if an and os.clock() < an.t then la, ra = an.la, an.ra end
		local f = math.clamp(dt * 10, 0, 1)
		P.la = P.la + (la - P.la) * f
		P.ra = P.ra + (ra - P.ra) * f
		P.ll = P.ll + (ll - P.ll) * f
		P.rl = P.rl + (rl - P.rl) * f
		N.Pose(R, P.la, P.ra, P.ll, P.rl)
	end)
end

function N.Ride()
	local S = N.S
	if not S.Landed or S.Riding or S.Busy then return end
	local R = N.R
	local char = lp.Character
	local hm = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hm and hrp and R) then return end
	S.Busy = true
	N.Refresh()
	hm.PlatformStand = true
	hrp.Anchored = true
	N.Snd("launch", 0.9, 1.3)
	local from = hrp.CFrame
	local t0 = os.clock()
	while true do
		local a = math.min((os.clock() - t0) / 1.2, 1)
		local e = a * a * (3 - 2 * a)
		local toCF = R.Seat.CFrame
		local p = from.Position:Lerp(toCF.Position, e) + V3(0, math.sin(a * math.pi) * 25, 0)
		hrp.CFrame = CF(p) * from.Rotation:Lerp(toCF.Rotation, e)
		if a >= 1 then break end
		RS.Heartbeat:Wait()
	end
	hrp.CFrame = R.Seat.CFrame
	weld = Instance.new("Weld")
	weld.Part0 = R.Seat
	weld.Part1 = hrp
	weld.C0 = CF()
	weld.Parent = hrp
	hrp.Anchored = false
	oldZoom = {lp.CameraMinZoomDistance, lp.CameraMaxZoomDistance}
	lp.CameraMaxZoomDistance = 300
	lp.CameraMinZoomDistance = 70
