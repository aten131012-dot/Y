local function mtween(R, to, dur)
	local m = N.Morph
	if not m then return false end
	local from = {}
	for key in pairs(to) do from[key] = m[key] or 0 end
	local t0 = os.clock()
	while true do
		if not (N.R == R and R.Model.Parent) then return false end
		local a = math.min((os.clock() - t0) / dur, 1)
		local e = a * a * (3 - 2 * a)
		for key, v in pairs(to) do m[key] = from[key] + (v - from[key]) * e end
		if a >= 1 then break end
		RS.Heartbeat:Wait()
	end
	return true
end

