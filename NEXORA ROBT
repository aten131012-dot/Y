local function meteors()
	local R = N.R
	local rp = N.RayParams(R)
	local g = groundAt(N.CamAim(rp), rp)
	N.Anim = {t = os.clock() + 4.2, la = 0, ra = 2.9}
	N.Snd("bass", 2, 0.6)
	N.Snd("unsheath", 1.2, 0.6)
	if R.SwordTip then N.Burst(R.SwordTip.Position, 25, NEON, 80, 0.6) end
	N.Ring(g + V3(0, 1, 0), 260, 1.0, NEON)
	N.Shake(0.6, 1)
	task.wait(0.6)
	local COUNT = 16
	for i = 1, COUNT do
		local big = i == COUNT
		if big then task.wait(0.5) end
		local off = big and V3() or V3((math.random() - 0.5) * 220, 0, (math.random() - 0.5) * 220)
		local tp = groundAt(g + off, rp)
		local sz = big and 36 or (10 + math.random() * 8)
		local start = tp + V3(-160, 520, -90)
		local m = newPart(Enum.PartType.Ball, Color3.fromRGB(45, 16, 16), Enum.Material.Slate, 0, V3(sz, sz, sz))
		m.Position = start
		local em = Instance.new("ParticleEmitter", m)
		em.Rate = 120
		em.Lifetime = NumberRange.new(0.6, 1)
		em.Speed = NumberRange.new(5, 15)
		em.SpreadAngle = Vector2.new(180, 180)
		em.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, sz * 0.6), NumberSequenceKeypoint.new(1, 0)})
		em.Color = ColorSequence.new(GLOW, Color3.fromRGB(120, 5, 10))
		em.LightEmission = 1
		em.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
		local lt = Instance.new("PointLight", m)
		lt.Color = GLOW
		lt.Range = 50
		lt.Brightness = 4
		local a0 = Instance.new("Attachment", m)
		a0.Position = V3(sz / 2, 0, 0)
		local a1 = Instance.new("Attachment", m)
		a1.Position = V3(-sz / 2, 0, 0)
		local tr = Instance.new("Trail", m)
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime = 0.6
		tr.LightEmission = 1
		tr.Color = ColorSequence.new(GLOW, Color3.fromRGB(120, 5, 10))
		tr.Transparency = NumberSequence.new(0, 1)

		N.Ring(tp + V3(0, 1, 0), big and 160 or 60, 0.9, NEON)
		N.Snd("whoosh", 0.9, 1.1, tp)
		local tw = TS:Create(m, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{Position = tp + V3(0, sz * 0.4, 0)})
		tw.Completed:Once(function()
			m:Destroy()
			N.Explode(tp, big and 90 or 36)
			N.Flash(tp + V3(0, 3, 0), big and 200 or 70, 0.5)
			N.Ring(tp + V3(0, 1, 0), big and 380 or 150, 0.8, GLOW)
			N.Burst(tp + V3(0, 3, 0), big and 40 or 12, GLOW, big and 200 or 80, 0.7)
			N.Shake(big and 1.5 or 0.4, big and 4 or 1.5)
		end)
		tw:Play()
		if not big then task.wait(0.17) end
	end
end

