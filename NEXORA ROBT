local function wingC0(s, i, len, t)
	local function lerp(a, b) return a + (b - a) * t end
	local roll = lerp(62 + (i - 1) * 3, 40 - (i - 1) * 14)
	local yaw = lerp(14, 8 + (i - 1) * 7)
	return CF(s * 1.8 * SC, 5.4 * SC, 2.6 * SC)
		* CFrame.Angles(0, -math.rad(yaw) * s, math.rad(roll) * s)
		* CF(s * len * 0.25 * SC, 0, 0)
end
N.WingC0 = wingC0

function N.Build()
	local M = Instance.new("Model")
	M.Name = "NEXORA_Giant"
	local RP, JP, RL, JL, RF, JF = {}, {}, {}, {}, {}, {}
	local c = {grp = "R"} -- R = ร่างหุ่น, J = ร่างเจ็ท

	local function mk(name, size, color, mat, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * SC
		p.Color = color
		p.Material = mat or Enum.Material.Metal
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.Anchored = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then p.Shape = shape end
		p.Parent = M
		if c.grp == "R" then RP[#RP + 1] = p else JP[#JP + 1] = p end
		return p
	end
	local root = mk("Root", V3(4, 1.6, 3), C.BLACK)
	root.Massless = false
	M.PrimaryPart = root
	local function weld(a, b, c0)
		local w = Instance.new("Weld")
		w.Part0 = a
		w.Part1 = b
		w.C0 = c0
		w.Parent = b
		return w
	end
	local function put(base, name, size, pos, color, mat, rot, shape)
		local p = mk(name, size, color, mat, shape)
		weld(base, p, CF(pos * SC) * (rot or CF()))
		return p
	end
	local function light(part, range, bright, color)
		local l = Instance.new("PointLight")
		l.Color = color or C.NEON
		l.Range = range
		l.Brightness = bright
		l.Parent = part
		if c.grp == "R" then RL[#RL + 1] = l else JL[#JL + 1] = l end
	end
	local function fx(inst)
		if c.grp == "R" then RF[#RF + 1] = inst else JF[#JF + 1] = inst end
	end

	local R = {Model = M, Root = root, J = {}, Wings = {}, Pods = {}, Thr = {}, JetThr = {}, JetGuns = {}, Eyes = {},
		RobotParts = RP, JetParts = JP, RobotLights = RL, JetLights = JL, RobotFX = RF, JetFX = JF,
		Form = "robot", Floor = FLOOR * SC}
	c.mk, c.weld, c.put, c.light, c.fx, c.R, c.root = mk, weld, put, light, fx, R, root

	for _, step in ipairs(N.BuildSteps) do step(c) end

	-- เส้นขอบเรืองแสงสีแดง
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineColor = C.GLOW
	hl.OutlineTransparency = 0.45
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = M

	N.SetForm(R, false)
	return R
end

-- สลับการมองเห็นระหว่างร่างหุ่น / ร่างเจ็ท
function N.SetForm(R, jet)
	R.Form = jet and "jet" or "robot"
	for _, p in ipairs(R.RobotParts) do
		if not p:GetAttribute("Keep") then p.Transparency = jet and 1 or 0 end
	end
	for _, p in ipairs(R.JetParts) do
		p.Transparency = jet and 0 or 1
	end
	for _, l in ipairs(R.RobotLights) do l.Enabled = not jet end
	for _, l in ipairs(R.JetLights) do l.Enabled = jet end
	for _, e in ipairs(R.RobotFX) do e.Enabled = not jet end
	for _, e in ipairs(R.JetFX) do e.Enabled = jet end
end

-- ค่อย ๆ จางร่างหนึ่งแล้วโผล่อีกร่าง (ใช้ตอนแปลงร่าง)
function N.Fade(R, toJet, dur)
	local t0 = os.clock()
	local swapped = false
	while R.Model.Parent do
		local a = math.min((os.clock() - t0) / dur, 1)
		local rv = toJet and a or (1 - a)
		for _, p in ipairs(R.RobotParts) do
			if not p:GetAttribute("Keep") then p.Transparency = rv end
		end
		for _, p in ipairs(R.JetParts) do p.Transparency = 1 - rv end
		if a >= 0.5 and not swapped then
			swapped = true
			for _, l in ipairs(R.RobotLights) do l.Enabled = not toJet end
			for _, l in ipairs(R.JetLights) do l.Enabled = toJet end
			for _, e in ipairs(R.RobotFX) do e.Enabled = not toJet end
			for _, e in ipairs(R.JetFX) do e.Enabled = toJet end
		end
		if a >= 1 then break end
		RS.Heartbeat:Wait()
	end
	if R.Model.Parent then N.SetForm(R, toJet) end
end

function N.WingPose(R, t)
	for _, wd in ipairs(R.Wings) do
		if wd.w.Parent then wd.w.C0 = wingC0(wd.s, wd.i, wd.len, t) end
	end
	R.WingT = t
end

function N.WingsTo(R, to, dur)
	local from = R.WingT or 1
	R.WingTok = (R.WingTok or 0) + 1
	local tok = R.WingTok
	task.spawn(function()
		local t0 = os.clock()
		while tok == R.WingTok and R.Model.Parent do
			local a = math.min((os.clock() - t0) / dur, 1)
			local e = a * a * (3 - 2 * a)
			N.WingPose(R, from + (to - from) * e)
			if a >= 1 then break end
			RS.Heartbeat:Wait()
		end
	end)
end

function N.Pose(R, la, ra, ll, rl)
	local J = R.J
	J.LArm.w.C0 = J.LArm.c0 * CFrame.Angles(la, 0, 0)
	J.RArm.w.C0 = J.RArm.c0 * CFrame.Angles(ra, 0, 0)
	J.LLeg.w.C0 = J.LLeg.c0 * CFrame.Angles(ll, 0, 0)
	J.RLeg.w.C0 = J.RLeg.c0 * CFrame.Angles(rl, 0, 0)
end

local function setFlames(list, on)
	for _, p in ipairs(list) do
		local e = p:FindFirstChild("Flame")
		if on and not e then
			local jetF = p:GetAttribute("JetFlame")
			e = Instance.new("ParticleEmitter")
			e.Name = "Flame"
			e.Color = ColorSequence.new(Color3.fromRGB(255, 150, 90), Color3.fromRGB(190, 15, 20))
			e.LightEmission = 1
			e.Rate = jetF and 120 or 80
			e.Lifetime = NumberRange.new(0.4, 0.8)
			e.Speed = jetF and NumberRange.new(60, 100) or NumberRange.new(25, 40)
			e.SpreadAngle = Vector2.new(5, 5)
			e.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, jetF and 5 or 3.4), NumberSequenceKeypoint.new(1, 0)})
			e.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
			e.EmissionDirection = jetF and Enum.NormalId.Back or Enum.NormalId.Bottom
			e.Parent = p
		end
		if e then e.Enabled = on end
	end
end

function N.Thrust(R, on)
	local jet = R.Form == "jet"
	setFlames(jet and R.Thr or R.JetThr, false)
	setFlames(jet and R.JetThr or R.Thr, on)
