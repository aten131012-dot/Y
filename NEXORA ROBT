local function demonking()
	local R = N.R
	local rp = N.RayParams(R)
	local cc
	pcall(function()
		cc = Instance.new("ColorCorrection")
		cc.Parent = Lighting
		TS:Create(cc, TweenInfo.new(1.2), {TintColor = Color3.fromRGB(255, 110, 100), Contrast = 0.15, Saturation = 0.2}):Play()
	end)
	local function corePos()
		return (R.Root.CFrame * CF(0, 3.2 * N.SCALE, -2.4 * N.SCALE)).Position
	end
	local function groundPos()
		return groundAt(R.Root.Position, rp)
	end
	N.Anim = {t = os.clock() + 2.4, la = 2.2, ra = 2.9}
	N.Snd("bass", 3, 0.4)
	N.Snd("ping", 2, 0.4)
	N.Shake(2.2, 2.5)

	-- ชาร์จพลัง
	local t0, last = os.clock(), -1
	while os.clock() - t0 < 2.2 do
		if not alive(R) then break end
		local el = os.clock() - t0
		if el - last > 0.35 then
			last = el
			N.Ring(groundPos() + V3(0, 1, 0), 120 + el * 160, 0.7, NEON)
			N.Burst(corePos(), 10, NEON, 40 + el * 30, 0.5)
			N.Flash(corePos(), 20 + el * 25, 0.4)
			N.Shake(0.35, 1 + el)
		end
		RS.Heartbeat:Wait()
	end

	if alive(R) then
		N.Snd("launch", 3, 0.5)
		N.Snd("boom", 2, 0.6)
		N.Flash(corePos(), 90, 0.5)
		N.Ring(groundPos() + V3(0, 1, 0), 450, 1.0, NEON)
		N.Burst(corePos(), 40, PALE, 120, 0.7)
		N.Shake(3.6, 3)
		N.Anim = {t = os.clock() + 4, la = 0.3, ra = 0.3}
		-- ลำแสงมหึมา (เล็งตามกล้อง กวาดได้)
		N.FireBeams(R, function() return {corePos()} end, 3.6, 12, function() return alive(R) end)
		if alive(R) then
			local g = groundPos()
			N.Explode(g, 80)
			N.Ring(g + V3(0, 1, 0), 600, 1.2, NEON)
			task.delay(0.15, function() N.Ring(g + V3(0, 1, 0), 400, 1.0, GLOW) end)
			N.Burst(corePos(), 50, NEON, 200, 0.9)
			N.Snd("boom", 3, 0.45, g)
			N.Shake(2, 4)
		end
	end

	if cc then
		TS:Create(cc, TweenInfo.new(1.0), {TintColor = Color3.new(1, 1, 1), Contrast = 0, Saturation = 0}):Play()
		Debris:AddItem(cc, 1.1)
	end
end

