local function bolt(g)
	local pts = {g + V3(0, 520, 0)}
	for i = 1, 7 do
		local f = i / 8
		local amp = 28 * (1 - f)
		pts[#pts + 1] = g + V3((math.random() - 0.5) * amp * 2, 520 * (1 - f), (math.random() - 0.5) * amp * 2)
	end
	pts[#pts + 1] = g
	local segs = {}
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local len = (b - a).Magnitude
		local o = newPart(nil, GLOW, NM, 0.2, V3(5, 5, len))
		o.CFrame = CFrame.lookAt(a, b) * CF(0, 0, -len / 2)
		local c = newPart(nil, PALE, NM, 0, V3(2, 2, len))
		c.CFrame = o.CFrame
		segs[#segs + 1] = o
		segs[#segs + 1] = c
	end
	for _, s in ipairs(segs) do
		TS:Create(s, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
		Debris:AddItem(s, 0.5)
	end
	flash(g, 70, 0.4)
	N.Ring(g + V3(0, 1, 0), 130, 0.5, GLOW)
	N.Burst(g + V3(0, 2, 0), 10, PALE, 60, 0.4)
	N.Shake(0.3, 1.5)
	explode(g, 26)
end

