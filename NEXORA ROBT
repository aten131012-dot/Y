local function godsword()
	local R = N.R
	local rp = rayParams(R)
	local aim = camAim(rp)
	local h = workspace:Raycast(aim + V3(0, 300, 0), V3(0, -900, 0), rp)
	local tgt = h and h.Position or aim
	N.Anim = {t = os.clock() + 2.6, la = 0, ra = 3.0}
	N.Snd("unsheath", 1.6, 0.6)
	N.Snd("bass", 2.2, 0.5)
	N.Shake(1.0, 1.0)
	for i = 0, 3 do
		task.delay(i * 0.2, function() N.Ring(tgt + V3(0, 1, 0), 240 - i * 50, 0.9, GLOW) end)
	end

	local parts = {}
	local function sp(size, off, color, mat, rot)
		local p = newPart(nil, color, mat, 0, size)
		parts[#parts + 1] = {p = p, off = CF(off) * (rot or CF())}
	end
	sp(V3(8, 140, 3), V3(0, 74, 0), PALE, NM)
	sp(V3(1.3, 140, 3.6), V3(4.6, 74, 0), GLOW, NM)
	sp(V3(1.3, 140, 3.6), V3(-4.6, 74, 0), GLOW, NM)
	sp(V3(5.7, 5.7, 3), V3(0, 4, 0), PALE, NM, CFrame.Angles(0, 0, math.rad(45)))
	sp(V3(44, 5, 7), V3(0, 146, 0), GOLD, Enum.Material.Metal)
	sp(V3(6, 6, 8), V3(0, 146, 0), NEON, NM)
	sp(V3(4, 34, 4), V3(0, 166, 0), GOLD, Enum.Material.Metal)
	sp(V3(7, 7, 7), V3(0, 186, 0), GLOW, NM)
	local top = tgt + V3(0, 700, 0)
	local function place(pos)
		for _, d in ipairs(parts) do d.p.CFrame = CF(pos) * d.off end
	end
	place(top)
	task.wait(0.9)
	N.Snd("launch", 2.2, 0.5)
	local t0 = os.clock()
	while true do
		local a = math.min((os.clock() - t0) / 0.8, 1)
		place(top:Lerp(tgt, a * a * a))
		if a >= 1 then break end
		RS.Heartbeat:Wait()
	end

	-- ปักพื้น: ระเบิดแสงใหญ่
	explode(tgt, 100)
	flash(tgt + V3(0, 10, 0), 260, 1.0)
	N.Ring(tgt + V3(0, 1, 0), 520, 1.4, GLOW)
	task.delay(0.15, function() N.Ring(tgt + V3(0, 1, 0), 380, 1.2, PALE) end)
	task.delay(0.3, function() N.Ring(tgt + V3(0, 1, 0), 240, 1.0, NEON) end)
	N.Dust(tgt + V3(0, 2, 0), 140)
	N.Burst(tgt + V3(0, 5, 0), 70, GLOW, 260, 1.1)
	N.Snd("boom", 3, 0.45, tgt)
	N.Snd("boom", 2.5, 0.8, tgt)
	N.Shake(2.0, 5)
	for k = 1, 12 do
		local ang = (k / 12) * math.pi * 2
		local d = V3(math.cos(ang), 0, math.sin(ang))
		local ray = newPart(nil, GLOW, NM, 0.2, V3(3, 3, 120))
		local from = tgt + V3(0, 3, 0) + d * 60
		ray.CFrame = CFrame.lookAt(from, from + d)
		local to = tgt + V3(0, 3, 0) + d * 260
		TS:Create(ray, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{CFrame = CFrame.lookAt(to, to + d), Transparency = 1}):Play()
		Debris:AddItem(ray, 0.9)
	end
	task.wait(1.4)
	for _, d in ipairs(parts) do
		TS:Create(d.p, TweenInfo.new(0.8), {Transparency = 1}):Play()
		Debris:AddItem(d.p, 0.9)
	end
end

