local function pillar(p)
	local a = newPart(nil, NEON, NM, 0.2, V3(4, 4, 4))
	local b = newPart(nil, PALE, NM, 0.1, V3(2, 4, 2))
	a.Position = p + V3(0, 2, 0)
	b.Position = p + V3(0, 2, 0)
	TS:Create(a, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = V3(18, 170, 18), Position = p + V3(0, 85, 0), Transparency = 1}):Play()
	TS:Create(b, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = V3(8, 170, 8), Position = p + V3(0, 85, 0), Transparency = 1}):Play()
	Debris:AddItem(a, 0.7)
	Debris:AddItem(b, 0.7)
	N.Explode(p, 22, true)
	N.Ring(p + V3(0, 1, 0), 60, 0.5, NEON)
	N.Burst(p + V3(0, 2, 0), 6, GLOW, 50, 0.5)
end

local function hellwave()
	local R = N.R
	local rp = N.RayParams(R)
	local look = workspace.CurrentCamera.CFrame.LookVector
	local fwd = V3(look.X, 0, look.Z)
	fwd = fwd.Magnitude > 0.01 and fwd.Unit or V3(0, 0, -1)
	local right = fwd:Cross(V3(0, 1, 0))
	local base = groundAt(R.Root.Position, rp)
	N.Anim = {t = os.clock() + 2.0, la = 2.4, ra = 2.4}
	N.Snd("bass", 2, 0.6)
	N.Ring(base + V3(0, 1, 0), 300, 1.0, NEON)
	N.Shake(1.6, 1.5)
	task.wait(0.35)
	if not alive(R) then return end
	N.Snd("boom", 2.5, 0.5, base)
	for k = 1, 10 do
		local dist = 40 + k * 34
		local n = 2 + math.floor(k / 2)
		local width = 20 + k * 20
		for j = 1, n do
			local lat = ((j - 1) / (n - 1) - 0.5) * 2 * width
			local p = groundAt(base + fwd * dist + right * lat, rp)
			pillar(p)
		end
		N.Shake(0.2, 1)
		task.wait(0.11)
	end
end

