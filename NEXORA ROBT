	lt.Range = 60
	lt.Brightness = 5
	local em = Instance.new("ParticleEmitter", ball)
	em.Rate = 80
	em.Lifetime = NumberRange.new(0.3, 0.6)
	em.Speed = NumberRange.new(15, 35)
	em.SpreadAngle = Vector2.new(180, 180)
	em.Size = NumberSequence.new(2, 0)
	em.Color = ColorSequence.new(NEON)
	em.LightEmission = 1
	em.Transparency = NumberSequence.new(0, 1)
	local function cleanup()
		ball:Destroy()
		core:Destroy()
		shell:Destroy()
	end
	-- ยกแขนซ้ายให้ปืนชี้ไปข้างหน้า (กระบอกปืนยาวตามแนวแขน)
	local armUp = 1.5
	N.Anim = {t = os.clock() + CH + 0.4, la = armUp, ra = 0}
	N.Snd("bass", 2, 1.0)
	N.Shake(CH, 1.4)
	local t0 = os.clock()
	local lastRing = -1
	local sz = 3
	while true do
		local el = os.clock() - t0
		if el >= CH then break end
		if not (N.R == R and R.Model.Parent) then cleanup() return end
		local k = el / CH
		sz = 3 + 26 * k * k + math.sin(el * 35) * 0.8
		local m = R.Muzzle
		local pos = m.Position - m.CFrame.UpVector * (sz * 0.5 + 1)
		ball.Size = V3(sz, sz, sz)
		ball.Position = pos
		core.Size = V3(sz * 0.55, sz * 0.55, sz * 0.55)
		core.Position = pos
		shell.Size = V3(sz * 1.5, sz * 1.5, sz * 1.5)
		shell.Position = pos
		lt.Brightness = 3 + k * 8
		if el - lastRing > 0.55 then
			lastRing = el
			local h = workspace:Raycast(R.Root.Position, V3(0, -600, 0), rp)
			local g = (h and h.Position or (R.Root.Position - V3(0, R.Floor, 0))) + V3(0, 1, 0)
			N.Ring(g, 60 + k * 140, 0.6, NEON)
		end
		RS.Heartbeat:Wait()
	end

	-- ยิง
	local pos = ball.Position
	local dir = (camAim(rp) - pos).Unit
	N.Anim = {t = os.clock() + 0.35, la = armUp - 0.3, ra = 0}
	N.Shake(0.5, 2.5)
	N.Snd("launch", 2, 0.6)
	N.Snd("boom", 1.5, 1.0)
	flash(pos, 60, 0.3)
	local t1 = os.clock()
	local c
	c = RS.Heartbeat:Connect(function(dt)
		local step = dir * 190 * dt
		local reach = step.Magnitude + sz * 0.5
		local hit = workspace:Raycast(pos, dir * reach, rp)
		if hit or os.clock() - t1 > 4 then
			c:Disconnect()
			local at = hit and hit.Position or pos
			cleanup()
			explode(at, 70)
			flash(at, 180, 0.9)
			N.Ring(at + V3(0, 1, 0), 380, 1.2, NEON)
			task.delay(0.15, function() N.Ring(at + V3(0, 1, 0), 260, 1.0, NEON) end)
			task.delay(0.3, function() N.Ring(at + V3(0, 1, 0), 160, 0.9, PALE) end)
			N.Dust(at + V3(0, 2, 0), 120)
			N.Burst(at + V3(0, 3, 0), 40, NEON, 220, 1.0)
			N.Shake(1.2, 4)
			return
		end
		pos = pos + step
		ball.Position, core.Position, shell.Position = pos, pos, pos
	end)
end

