function N.FireBeams(R, getO, dur, ws, alive)
	ws = ws or 1
	local rp = rayParams(R)
	local beams = {}
	for i = 1, #getO() do
		beams[i] = {
			newPart(nil, NEON, NM, 0.2, V3(1, 1, 1)),
			newPart(nil, PALE, NM, 0, V3(1, 1, 1)),
		}
	end
	N.Snd("launch", 1.5, 2.0)
	local t0, last = os.clock(), 0
	while true do
		local el = os.clock() - t0
		if el >= dur or not alive() then break end
		local aim = camAim(rp)
		local origins = getO()
		local grow = math.min(el / 0.12, 1) * (1 - math.max(el - (dur - 0.3), 0) / 0.3)
		local wd = math.max((0.8 + math.sin(el * 60) * 0.15) * ws * grow, 0.05)
		local tick = el - last > 0.1
		for i, o in ipairs(origins) do
			local b = beams[i]
			if b then
				local d = aim - o
				if d.Magnitude < 1 then d = workspace.CurrentCamera.CFrame.LookVector end
				d = d.Unit
				local hit = workspace:Raycast(o, d * 2500, rp)
				local e = hit and hit.Position or (o + d * 2500)
				local len = math.max((e - o).Magnitude, 0.1)
				b[1].Size = V3(wd * 2, wd * 2, len)
				b[1].CFrame = CFrame.lookAt(o, e) * CF(0, 0, -len / 2)
				b[2].Size = V3(wd * 0.8, wd * 0.8, len)
				b[2].CFrame = b[1].CFrame
				if hit and tick then
					flash(e, 24, 0.3)
					N.Dust(e, 5)
					explode(e, 12, true)
				end
			end
		end
		if tick then last = el end
		RS.Heartbeat:Wait()
	end
	for _, b in ipairs(beams) do
		b[1]:Destroy()
		b[2]:Destroy()
	end
end

